fill=\"url(#lf-_R_l9rp5ftb_-4)\"></polygon><polygon points=\"12.00,12.00 1.91,8.72 9.26,8.23\" fill=\"url(#rf-_R_l9rp5ftb_-4)\"></polygon></g></g><path d=\"M10.14,6.04 Q12.00,1.39 13.86,6.04 L14.03,6.45 Q14.74,8.23 16.65,8.36 L17.09,8.39 Q22.09,8.72 18.24,11.93 L17.90,12.21 Q16.43,13.44 16.90,15.30 L17.01,15.72 Q18.24,20.58 14.00,17.91 L13.62,17.68 Q12.00,16.66 10.38,17.68 L10.00,17.91 Q5.76,20.58 6.99,15.72 L7.10,15.30 Q7.57,13.44 6.10,12.21 L5.76,11.93 Q1.91,8.72 6.91,8.39 L7.35,8.36 Q9.26,8.23 9.97,6.45 Z\" fill=\"black\" filter=\"url(#tx-_R_l9rp5ftb_)\" style=\"mix-blend-mode:soft-light\" opacity=\"0.08\"></path><g clip-path=\"url(#cl-_R_l9rp5ftb_)\" filter=\"url(#cg-_R_l9rp5ftb_)\"><line x1=\"12\" y1=\"12\" x2=\"12\" y2=\"1.3919999999999995\" stroke=\"url(#sc-_R_l9rp5ftb_-0)\" stroke-width=\"0.312\" stroke-linecap=\"round\"></line><line x1=\"12\" y1=\"12\" x2=\"22.08880752485899\" y2=\"8.721947723670558\" stroke=\"url(#sc-_R_l9rp5ftb_-1)\" stroke-width=\"0.312\" stroke-linecap=\"round\"></line><line x1=\"12\" y1=\"12\" x2=\"18.235225956318555\" y2=\"20.582052276329442\" stroke=\"url(#sc-_R_l9rp5ftb_-2)\" stroke-width=\"0.312\" stroke-linecap=\"round\"></line><line x1=\"12\" y1=\"12\" x2=\"5.764774043681446\" y2=\"20.582052276329442\" stroke=\"url(#sc-_R_l9rp5ftb_-3)\" stroke-width=\"0.312\" stroke-linecap=\"round\"></line><line x1=\"12\" y1=\"12\" x2=\"1.911192475141009\" y2=\"8.72194772367056\" stroke=\"url(#sc-_R_l9rp5ftb_-4)\" stroke-width=\"0.312\" stroke-linecap=\"round\"></line></g><path d=\"M10.14,6.04 Q12.00,1.39 13.86,6.04 L14.03,6.45 Q14.74,8.23 16.65,8.36 L17.09,8.39 Q22.09,8.72 18.24,11.93 L17.90,12.21 Q16.43,13.44 16.90,15.30 L17.01,15.72 Q18.24,20.58 14.00,17.91 L13.62,17.68 Q12.00,16.66 10.38,17.68 L10.00,17.91 Q5.76,20.58 6.99,15.72 L7.10,15.30 Q7.57,13.44 6.10,12.21 L5.76,11.93 Q1.91,8.72 6.91,8.39 L7.35,8.36 Q9.26,8.23 9.97,6.45 Z\" fill=\"black\" filter=\"url(#sp-_R_l9rp5ftb_)\" style=\"mix-blend-mode:screen\"></path><path d=\"M10.14,6.04 Q12.00,1.39 13.86,6.04 L14.03,6.45 Q14.74,8.23 16.65,8.36 L17.09,8.39 Q22.09,8.72 18.24,11.93 L17.90,12.21 Q16.43,13.44 16.90,15.30 L17.01,15.72 Q18.24,20.58 14.00,17.91 L13.62,17.68 Q12.00,16.66 10.38,17.68 L10.00,17.91 Q5.76,20.58 6.99,15.72 L7.10,15.30 Q7.57,13.44 6.10,12.21 L5.76,11.93 Q1.91,8.72 6.91,8.39 L7.35,8.36 Q9.26,8.23 9.97,6.45 Z\" fill=\"none\" stroke=\"rgba(80,140,255,0.15)\" stroke-width=\"0.672\" clip-path=\"url(#cl-_R_l9rp5ftb_)\"></path></svg></span><h3 class=\"text-lg font-bold capitalize text-navy\">growth</h3></div><p class=\"mt-2 text-3xl font-extrabold tracking-tight text-navy\">$<!-- -->99<span class=\"text-sm font-normal text-text-faint\">/mo</span></p><p class=\"mt-2 text-sm text-text-muted\">The complete review stack for growing stores</p><ul class=\"mt-6 flex-1 space-y-2.5\"><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>2,000 invitations + SMS/month</span></li><li class=\"flex gap-2.5 text-sm text-text-faint\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Video reviews<span class=\"ml-1.5 rounded-full bg-surface-offset px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wide text-text-faint\">Coming soon</span></span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>AI review summaries</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Google Seller Ratings</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>6 widget types</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>3 user seats</span></li></ul><a class=\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-gold text-white hover:bg-gold-dark border-transparent shadow-[var(--shadow-gold)] h-10 px-5 text-sm mt-8 w-full\" href=\"/contact\">Contact us</a></div></div><div class=\"relative flex flex-col overflow-hidden rounded-2xl border bg-white shadow-[0_4px_12px_rgba(15,32,68,0.08),0_16px_40px_rgba(15,32,68,0.06)] border-border\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"h-1 bg-gradient-to-r from-navy/20 via-border to-navy/20\"></div><div class=\"flex flex-1 flex-col p-6 pt-7\"><span class=\"absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-3 py-0.5 text-xs font-semibold tracking-wide border border-gold/30 bg-gold-pale text-gold-dark\">Best Value</span><div class=\"flex items-center gap-2\"><h3 class=\"text-lg font-bold capitalize text-navy\">pro</h3></div><p class=\"mt-2 text-3xl font-extrabold tracking-tight text-navy\">$<!-- -->249<span class=\"text-sm font-normal text-text-faint\">/mo</span></p><p class=\"mt-2 text-sm text-text-muted\">For high-volume stores</p><ul class=\"mt-6 flex-1 space-y-2.5\"><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>15,000 invitations/month</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>AI Q&amp;A SEO module</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Multi-platform syndication</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Full analytics + API</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>10 user seats</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>99.9% SLA</span></li></ul><a class=\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-navy text-white hover:bg-navy-mid border-transparent h-10 px-5 text-sm mt-8 w-full\" href=\"/contact\">Contact us</a></div></div><div class=\"relative flex flex-col overflow-hidden rounded-2xl border bg-white shadow-[0_4px_12px_rgba(15,32,68,0.08),0_16px_40px_rgba(15,32,68,0.06)] border-border\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"h-1 bg-gradient-to-r from-navy/20 via-border to-navy/20\"></div><div class=\"flex flex-1 flex-col p-6 pt-7\"><span class=\"absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-3 py-0.5 text-xs font-semibold tracking-wide border border-gold/30 bg-gold-pale text-gold-dark\">White-Label</span><div class=\"flex items-center gap-2\"><h3 class=\"text-lg font-bold capitalize text-navy\">agency</h3></div><p class=\"mt-2 text-3xl font-extrabold tracking-tight text-navy\">$<!-- -->749<span class=\"text-sm font-normal text-text-faint\">/mo</span></p><p class=\"mt-2 text-sm text-text-muted\">Run reviews for all your clients</p><ul class=\"mt-6 flex-1 space-y-2.5\"><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Unlimited invitations</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Full white-label branding</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>25 sub-accounts</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Dedicated CSM</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold\" aria-hidden=\"true\">★</span><span>Priority Slack support</span></li></ul><a class=\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-navy text-white hover:bg-navy-mid border-transparent h-10 px-5 text-sm mt-8 w-full\" href=\"/contact\">Contact us</a></div></div></div><p class=\"mt-10 text-center text-xs text-text-faint\" style=\"opacity:0\">Every plan includes the EarnedStar badge · Verified by Purchase on every review</p></div></section><section class=\"relative overflow-hidden bg-cream py-24 paper-grain md:py-32\"><div class=\"relative mx-auto grid max-w-[1100px] grid-cols-1 items-center gap-12 px-6 sm:px-10 md:grid-cols-12 lg:px-14\"><div class=\"md:col-span-7\"><span class=\"smallcaps text-[10px] text-gold-dark\">A free public tool</span><h3 class=\"font-heading mt-4 text-[clamp(2.2rem,4vw,3.6rem)] leading-[1.05] tracking-tight text-balance\">Paste any Trustpilot or Yotpo profile.<br/><em class=\"text-gold-dark underline-hand\">We&#x27;ll estimate how many reviews are fake.</em></h3><p class=\"mt-6 max-w-lg text-pretty leading-[1.65] text-ink/65\">The Review Audit runs an AI forensic scan and returns a shareable PDF report — language clusters, timing anomalies, reviewer history patterns. We do this free because we have nothing to hide.</p><a class=\"group mt-8 inline-flex items-center gap-2 rounded-full bg-ink px-6 py-3.5 font-semibold text-white transition-colors hover:bg-ink-soft\" href=\"/audit\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search\" aria-hidden=\"true\"><path d=\"m21 21-4.34-4.34\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle></svg> Run a Review Audit<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right transition-transform group-hover:translate-x-0.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a></div><div class=\"relative flex justify-center md:col-span-5\"><div class=\"absolute -inset-8 bg-gradient-to-tr from-gold-dark/20 via-gold/15 to-transparent blur-2xl\" aria-hidden=\"true\"></div><div class=\"animate-editorial-float relative\"><img alt=\"EarnedStar award medallion\" loading=\"lazy\" width=\"260\" height=\"260\" decoding=\"async\" data-nimg=\"1\" class=\"max-w-full drop-shadow-[0_20px_40px_rgba(180,83,9,0.35)]\" style=\"color:transparent\" src=\"/marketing/es005-nano-banana.png\"/></div></div></div></section><section id=\"faq\" class=\"section-stone py-24\" data-scroll-theme=\"light\"><div class=\"mx-auto max-w-3xl px-4\"><h2 class=\"text-center text-3xl font-bold text-navy\">Questions? We&#x27;ve got answers.</h2><div class=\"mt-12 space-y-2\"><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"true\"><span class=\"font-medium text-navy\">Can random people leave reviews on my store?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition rotate-180\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button><div style=\"height:auto;opacity:1\"><p class=\"border-t border-border px-4 py-4 text-sm text-text-muted\">No. Reviews require a purchase-matched invitation. Without a verified order, a submission never reaches your public profile — that&#x27;s core to the EarnedStar name.</p></div></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">Can I import reviews I already have?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">Why can&#x27;t I add extra reviews manually later?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">Is every review actually verified to a real purchase?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">How does the AI fraud detection actually work?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">Which e-commerce platforms do you support?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">How long does it take for Google stars to appear?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">What happens to my reviews if I cancel?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">How does the Agency white-label plan work?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">Is there a free plan?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div><div class=\"card-surface overflow-hidden\"><button type=\"button\" class=\"flex w-full items-center justify-between p-4 text-left focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gold\" aria-expanded=\"false\"><span class=\"font-medium text-navy\">Can I collect photo and video reviews?</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-chevron-down shrink-0 text-text-muted transition\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"></path></svg></button></div></div></div></section><section class=\"relative overflow-hidden bg-ink py-20 text-white\" data-surface=\"dark\"><div class=\"grain-overlay absolute inset-0 opacity-50\" aria-hidden=\"true\"></div><div class=\"relative mx-auto max-w-[1100px] px-6 text-center sm:px-10 lg:px-14\"><div class=\"smallcaps mb-5 text-[10px] text-gold-light\">A trust manifesto</div><p class=\"font-heading mx-auto max-w-3xl text-[clamp(1.5rem,2.6vw,2.2rem)] leading-[1.4] text-balance text-white/85 italic\">We&#x27;re not building another review widget. We&#x27;re building the trust layer that e-commerce should have had from the start.</p><div class=\"mt-8 flex items-center justify-center gap-3\"><span class=\"h-px w-12 bg-gold/50\"></span><span class=\"smallcaps text-[10px] text-white/40\">Volume I · Edition 2026</span><span class=\"h-px w-12 bg-gold/50\"></span></div></div></section></main><footer class=\"border-t border-border bg-navy text-white\" data-scroll-theme=\"dark\"><section class=\"py-20 text-center\"><div class=\"mx-auto max-w-3xl px-4\"><h2 class=\"font-display text-3xl italic text-gold\">Stop guessing if customers