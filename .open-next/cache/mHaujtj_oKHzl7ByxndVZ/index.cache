5,255,255,0.05)\" stroke=\"rgba(255,255,255,0.78)\" stroke-width=\"0.726\" stroke-linejoin=\"round\"></path><line x1=\"16.5\" y1=\"16.5\" x2=\"16.5\" y2=\"1.9139999999999997\" stroke=\"rgba(255,255,255,0.28)\" stroke-width=\"0.429\" stroke-linecap=\"round\"></line><line x1=\"16.5\" y1=\"16.5\" x2=\"30.37211034668111\" y2=\"11.992678120047017\" stroke=\"rgba(255,255,255,0.28)\" stroke-width=\"0.429\" stroke-linecap=\"round\"></line><line x1=\"16.5\" y1=\"16.5\" x2=\"25.073435689938016\" y2=\"28.300321879952982\" stroke=\"rgba(255,255,255,0.28)\" stroke-width=\"0.429\" stroke-linecap=\"round\"></line><line x1=\"16.5\" y1=\"16.5\" x2=\"7.926564310061988\" y2=\"28.300321879952982\" stroke=\"rgba(255,255,255,0.28)\" stroke-width=\"0.429\" stroke-linecap=\"round\"></line><line x1=\"16.5\" y1=\"16.5\" x2=\"2.6278896533188885\" y2=\"11.99267812004702\" stroke=\"rgba(255,255,255,0.28)\" stroke-width=\"0.429\" stroke-linecap=\"round\"></line></svg><span class=\"font-sans font-bold leading-none tracking-tight\" style=\"font-size:13px\"><span class=\"text-white\">Earned</span><span class=\"text-gold\">Star</span></span></span></a><div class=\"hidden items-center gap-7 md:flex\"><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-white\" href=\"/\">Manifesto</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-white/65 hover:text-white\" href=\"/pricing\">Pricing</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-white/65 hover:text-white\" href=\"/audit\">The Audit</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-white/65 hover:text-white\" href=\"/yotpo-refugees\">Yotpo Refugees</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-white/65 hover:text-white\" href=\"/reviews/expedia-parts\">Live Store</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-white/65 hover:text-white\" href=\"/design-lab/brand\">Brand</a></div><div class=\"hidden items-center gap-3 md:flex\"><span class=\"smallcaps hidden text-[10px] lg:inline text-white/40\">Vol. 01 · 2026</span><a class=\"rounded-full px-4 py-2 text-[13px] font-bold text-ink shadow-sm transition-shadow gold-foil hover:shadow-md\" href=\"/signup\">Start free</a></div><button type=\"button\" class=\"rounded-md p-2 md:hidden text-white\" aria-label=\"Open menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></nav></header><main><section class=\"relative -mt-16 overflow-hidden bg-ink pt-16 text-white\" data-scroll-theme=\"dark\" data-surface=\"dark\"><div class=\"grain-overlay absolute inset-0\" aria-hidden=\"true\"></div><div class=\"ring-light pointer-events-none absolute inset-0\" aria-hidden=\"true\"></div><div class=\"absolute -right-32 -top-40 h-[680px] w-[680px] rounded-full opacity-40\" style=\"background:radial-gradient(circle at 30% 30%, rgba(245,158,11,0.55) 0%, transparent 60%)\" aria-hidden=\"true\"></div><div class=\"absolute bottom-0 left-0 h-[420px] w-[420px] rounded-full opacity-20\" style=\"background:radial-gradient(circle, rgba(253,230,138,0.45) 0%, transparent 60%)\" aria-hidden=\"true\"></div><div class=\"relative border-b border-white/10\"><div class=\"mx-auto flex max-w-[1400px] items-center justify-between px-6 py-3 text-[10px] text-white/40 sm:px-10 lg:px-14\"><span class=\"smallcaps\">Manifesto · Edition I</span><span class=\"hidden sm:inline\">EarnedStar — A Trust Manifesto for E-Commerce</span><span class=\"font-num tabular-nums\"></span></div></div><div class=\"relative mx-auto grid max-w-[1400px] grid-cols-1 gap-12 px-6 py-20 md:py-32 lg:grid-cols-12 lg:gap-16 sm:px-10 lg:px-14\"><div class=\"space-y-9 lg:col-span-7\"><div class=\"flex items-center gap-3\" style=\"opacity:0;transform:translateY(6px)\"><span class=\"h-px w-10 bg-gold/70\"></span><span class=\"smallcaps text-gold-light\">The Trust Stack · Post-Yotpo Era</span></div><h1 class=\"font-heading text-[clamp(3rem,7vw,6.5rem)] leading-[0.95] tracking-tight text-balance text-white\" style=\"opacity:0;transform:translateY(14px)\">Reviews that<!-- --> <em class=\"text-gold-light underline-hand\">earned</em><br/>their place — and <em class=\"text-gold-light underline-hand\">prove</em> it.</h1><p class=\"max-w-xl text-lg leading-[1.55] text-pretty text-white/72 sm:text-xl\" style=\"opacity:0;transform:translateY(10px)\">The only e-commerce review platform where every star is order-verified, AI-fraud-audited, and publicly provable. Bundled with native email, SMS, and loyalty — at flat prices that don&#x27;t punish you for growing.</p><div class=\"flex flex-wrap items-center gap-4 pt-2\" style=\"opacity:0;transform:translateY(8px)\"><a class=\"group inline-flex items-center gap-2.5 rounded-full px-6 py-3.5 font-bold text-ink shadow-[0_18px_40px_-12px_rgba(245,158,11,0.5)] transition-all gold-foil hover:shadow-[0_24px_50px_-12px_rgba(245,158,11,0.7)]\" href=\"/signup\">Start free trial<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"16\" height=\"16\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right transition-transform group-hover:translate-x-0.5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></a><a class=\"inline-flex items-center gap-2 rounded-full border border-white/20 px-6 py-3.5 font-semibold text-white backdrop-blur-sm transition-colors hover:border-white/35 hover:bg-white/8\" href=\"/yotpo-refugees\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles text-gold-light\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg>Yotpo killed your email? Migrate free</a></div><div class=\"flex items-center gap-4 pt-6 text-[11px] text-white/40\"><span class=\"smallcaps\">Trusted by merchants in</span><div class=\"font-num flex items-center gap-3 tabular-nums\"><span>14 verticals</span><span class=\"h-1 w-1 rounded-full bg-white/20\"></span><span>22 countries</span><span class=\"h-1 w-1 rounded-full bg-white/20\"></span><span>1 promise</span></div></div></div><div class=\"relative flex items-center justify-center lg:col-span-5 lg:justify-end\"><div class=\"relative\" style=\"opacity:0;transform:scale(0.92) rotate(-6deg)\"><div class=\"animate-editorial-orbit pointer-events-none absolute -inset-16\"><svg viewBox=\"0 0 400 400\" class=\"h-full w-full\" aria-hidden=\"true\"><defs><linearGradient id=\"orbit-grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\"><stop offset=\"0%\" stop-color=\"#FDE68A\" stop-opacity=\"0.55\"></stop><stop offset=\"50%\" stop-color=\"#F59E0B\" stop-opacity=\"0.28\"></stop><stop offset=\"100%\" stop-color=\"#92400E\" stop-opacity=\"0\"></stop></linearGradient></defs><circle cx=\"200\" cy=\"200\" r=\"186\" fill=\"none\" stroke=\"url(#orbit-grad)\" stroke-width=\"1.5\" stroke-dasharray=\"3 9\"></circle></svg></div><div class=\"absolute -inset-10 bg-gradient-to-tr from-gold-dark/55 via-gold/30 to-transparent blur-3xl\" aria-hidden=\"true\"></div><div class=\"animate-editorial-float relative\"><img alt=\"EarnedStar 3D leather lucky star with verification metrics\" width=\"520\" height=\"520\" decoding=\"async\" data-nimg=\"1\" class=\"max-w-full drop-shadow-[0_40px_80px_rgba(0,0,0,0.65)]\" style=\"color:transparent\" src=\"/marketing/es-hero-badge.png\"/></div><div class=\"absolute -bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap rounded-full border border-white/15 bg-ink/80 px-4 py-1.5 text-[10px] text-gold-light backdrop-blur-sm smallcaps\">Hand-rendered · 3D leather</div></div></div></div></section><div class=\"relative border-t border-white/10 bg-ink-deep\" data-surface=\"dark\"><div class=\"mx-auto grid max-w-[1400px] grid-cols-2 gap-8 px-6 py-8 md:grid-cols-4 md:gap-12 sm:px-10 lg:px-14\"><div class=\"relative\"><div class=\"absolute -left-2 top-0 h-full w-px bg-gradient-to-b from-gold/0 via-gold/60 to-gold/0\"></div><div class=\"pl-2\"><div class=\"font-heading text-[clamp(2rem,3.5vw,3rem)] leading-none tracking-tight text-white\"><span class=\"font-num tabular-nums\">0</span></div><div class=\"smallcaps mt-2.5 text-[9.5px] text-gold-light\">Verified reviews</div><div class=\"mt-1 text-[10px] text-white/60\">live ledger</div></div></div><div class=\"relative\"><div class=\"absolute -left-2 top-0 h-full w-px bg-gradient-to-b from-gold/0 via-gold/60 to-gold/0\"></div><div class=\"pl-2\"><div class=\"font-heading text-[clamp(2rem,3.5vw,3rem)] leading-none tracking-tight text-white\"><span class=\"font-num tabular-nums\">0</span></div><div class=\"smallcaps mt-2.5 text-[9.5px] text-gold-light\">Fraud attempts blocked</div><div class=\"mt-1 text-[10px] text-white/60\">this month</div></div></div><div class=\"relative\"><div class=\"absolute -left-2 top-0 h-full w-px bg-gradient-to-b from-gold/0 via-gold/60 to-gold/0\"></div><div class=\"pl-2\"><div class=\"font-heading text-[clamp(2rem,3.5vw,3rem)] leading-none tracking-tight text-white\"><span class=\"font-num tabular-nums\">0<!-- -->h</span></div><div class=\"smallcaps mt-2.5 text-[9.5px] text-gold-light\">Avg. dispute SLA</div><div class=\"mt-1 text-[10px] text-white/60\">Trustpilot: 7–14 days</div></div></div><div class=\"relative\"><div class=\"absolute -left-2 top-0 h-full w-px bg-gradient-to-b from-gold/0 via-gold/60 to-gold/0\"></div><div class=\"pl-2\"><div class=\"font-heading text-[clamp(2rem,3.5vw,3rem)] leading-none tracking-tight text-white\"><span class=\"font-num tabular-nums\">0</span></div><div class=\"smallcaps mt-2.5 text-[9.5px] text-gold-light\">Reviews ransomed</div><div class=\"mt-1 text-[10px] text-white/60\">your data, forever</div></div></div></div><div class=\"border-t border-white/10\"><div class=\"marquee-mask mx-auto flex max-w-[1400px] items-center gap-6 overflow-hidden px-6 py-4 sm:px-10 lg:px-14\"><span class=\"smallcaps shrink-0 text-[10px] text-white/60\">As seen in</span><div class=\"animate-editorial-ticker flex items-center gap-10 whitespace-nowrap\"><span class=\"font-heading text-lg italic tracking-tight text-white/60\">TechCrunch</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Modern Retail</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">The Hustle</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Retail Dive</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Shopify</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Practical Ecommerce</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Inc.</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Bloomberg</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">TechCrunch</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Modern Retail</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">The Hustle</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Retail Dive</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Shopify</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Practical Ecommerce</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Inc.</span><span class=\"font-heading text-lg italic tracking-tight text-white/60\">Bloomberg</span></div></div></div></div><section class=\"relative overflow-hidden bg-cream py-24 paper-grain md:py-36\"><div class=\"relative mx-auto max-w-[1100px] px-6 sm:px-10 lg:px-14\"><div class=\"mb-10 flex items-center gap-4\"><span class=\"smallcaps text-[10px] text-gold-dark\">Editor&#x27;s Note</span><span class=\"magazine-rule flex-1 text-ink/20\"></span><span class=\"smallcaps text-[10px] text-ink/40\">Chapter 01</span></div><div class=\"relative pl-12 md:pl-20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"64\" height=\"64\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"0.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-quote absolute -left-2 top-2 text-gold-dark/30\" aria-hidden=\"true\"><path d=\"M16 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path><path d=\"M5 3a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2 1 1 0 0 1 1 1v1a2 2 0 0 1-2 2 1 1 0 0 0-1 1v2a1 1 0 0 0 1 1 6 6 0 0 0 6-6V5a2 2 0 0 0-2-2z\"></path></svg><blockquote class=\"font-heading text-[clamp(2rem,4vw,3.4rem)] leading-[1.08] text-balance text-ink\">Stars used to mean something. Somewhere between the affiliate marketers, the fake-review services, and the “pay-to-protect” quotas, they stopped. We built EarnedStar to put them back where they belong:<!-- --> <em class=\"not-italic font-normal gold-text\">earned, audited, and yours</em>.</blockquote><div class=\"mt-10 flex items-center gap-4\"><div class=\"flex h-12 w-12 items-center justify-center rounded-full bg-gradient-to-br from-gold-light to-gold-dark font-heading text-xl italic text-ink\">M</div><div><div class=\"font-bold tracking-tight text-ink\">M. Benav</div><div class=\"text-xs text-ink/50\">Founder &amp; CEO — EarnedStar</div></div><div class=\"font-num ml-6 hidden text-[10px] text-ink/40 smallcaps tabular-nums md:block\">№ 001 · 2026</div></div></div></div></section><section id=\"manifesto\" class=\"relative overflow-hidden border-y border-ink/8 bg-vellum py-24 paper-grain md:py-32\"><div class=\"relative mx-auto grid max-w-[1400px] grid-cols-1 gap-12 px-6 sm:px-10 lg:grid-cols-12 lg:gap-16 lg:px-14\"><div class=\"self-start lg:sticky lg:top-24 lg:col-span-4\"><div class=\"smallcaps text-[10px] text-gold-dark\">The Manifesto</div><h2 class=\"font-heading mt-4 text-[clamp(2.5rem,4.5vw,4rem)] leading-[1.02] tracking-tight text-balance\">Four promises. <em class=\"text-gold-dark underline-hand\">Publicly</em>.</h2><p class=\"mt-6 max-w-md text-base leading-[1.6] text-ink/65\">No platform in this category has ever committed to truth publicly. We are. Every promise below becomes a feature you can audit, share, and hold us to — in the open.</p><div class=\"smallcaps mt-8 flex items-center gap-3 text-[10px] text-ink/40\"><span class=\"h-px w-8 bg-ink/20\"></span> est. January 2026</div></div><div class=\"grid grid-cols-1 gap-px bg-ink/10 sm:grid-cols-2 lg:col-span-8\"><div class=\"group bg-cream-light p-10\" style=\"opacity:0;transform:translateY(14px)\"><div class=\"flex items-start justify-between\"><span class=\"font-heading text-[2.2rem] leading-none text-gold-dark/70 italic\">I<!-- -->.</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield text-ink/30 transition-colors group-hover:text-gold-dark\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div><h3 class=\"font-heading mt-6 text-4xl leading-tight text-ink italic\">Verified</h3><div class=\"mt-4 h-px w-10 bg-gold-dark/40\"></div><p class=\"mt-4 text-pretty leading-[1.65] text-ink/65\">Every review tied to a real, fulfilled order. Never an open form. Never an exception.</p></div><div class=\"group bg-cream-light p-10\" style=\"opacity:0;transform:translateY(14px)\"><div class=\"flex items-start justify-between\"><span class=\"font-heading text-[2.2rem] leading-none text-gold-dark/70 italic\">II<!-- -->.</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text text-ink/30 transition-colors group-hover:text-gold-dark\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><h3 class=\"font-heading mt-6 text-4xl leading-tight text-ink italic\">Auditable</h3><div class=\"mt-4 h-px w-10 bg-gold-dark/40\"></div><p class=\"mt-4 text-pretty leading-[1.65] text-ink/65\">Every star ships with a public Trust Receipt. Order hash, identity tier, fraud signals — all readable by anyone.</p></div><div class=\"group bg-cream-light p-10\" style=\"opacity:0;transform:translateY(14px)\"><div class=\"flex items-start justify-between\"><span class=\"font-heading text-[2.2rem] leading-none text-gold-dark/70 italic\">III<!-- -->.</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-lock text-ink/30 transition-colors group-hover:text-gold-dark\" aria-hidden=\"true\"><rect width=\"18\" height=\"11\" x=\"3\" y=\"11\" rx=\"2\" ry=\"2\"></rect><path d=\"M7 11V7a5 5 0 0 1 10 0v4\"></path></svg></div><h3 class=\"font-heading mt-6 text-4xl leading-tight text-ink italic\">Portable</h3><div class=\"mt-4 h-px w-10 bg-gold-dark/40\"></div><p class=\"mt-4 text-pretty leading-[1.65] text-ink/65\">Your reviews are your data. One-click export to JSON-LD or CSV. They survive your cancellation. Forever.</p></div><div class=\"group bg-cream-light p-10\" style=\"opacity:0;transform:translateY(14px)\"><div class=\"flex items-start justify-between\"><span class=\"font-heading text-[2.2rem] leading-none text-gold-dark/70 italic\">IV<!-- -->.</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.4\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-scale text-ink/30 transition-colors group-hover:text-gold-dark\" aria-hidden=\"true\"><path d=\"M12 3v18\"></path><path d=\"m19 8 3 8a5 5 0 0 1-6 0zV7\"></path><path d=\"M3 7h1a17 17 0 0 0 8-2 17 17 0 0 0 8 2h1\"></path><path d=\"m5 8 3 8a5 5 0 0 1-6 0zV7\"></path><path d=\"M7 21h10\"></path></svg></div><h3 class=\"font-heading mt-6 text-4xl leading-tight text-ink italic\">Fair</h3><div class=\"mt-4 h-px w-10 bg-gold-dark/40\"></div><p class=\"mt-4 text-pretty leading-[1.65] text-ink/65\">Flat pricing. Multi-domain included. No pay-to-protect schemes. Negative reviews never bought, never buried.</p></div></div></div></section><section class=\"relative overflow-hidden border-y border-ink/8 bg-cream-light py-24 md:py-32\"><div class=\"paper-grain pointer-events-none absolute inset-0\" aria-hidden=\"true\"></div><div class=\"relative mx-auto max-w-[1400px] px-6 sm:px-10 lg:px-14\"><div class=\"mb-14 grid grid-cols-1 items-end gap-12 lg:grid-cols-12\"><div class=\"lg:col-span-7\"><div class=\"smallcaps mb-3 text-[10px] text-gold-dark\">The Mark</div><h2 class=\"font-heading text-[clamp(2.5rem,5vw,4.5rem)] leading-[1.02] tracking-tight text-balance\">A trust badge worth <em class=\"text-gold-dark underline-hand\">earning</em>.</h2></div><div class=\"lg:col-span-5\"><p class=\"text-pretty leading-[1.65] text-ink/65\">Padded navy leather. Gold piping. A medallion that holds <em class=\"italic\">your</em> logo — because every star on the platform points back to a real merchant who earned it.</p></div></div><div class=\"grid grid-cols-1 items-center gap-10 lg:grid-cols-12\"><div class=\"vellum-card gilded-edge relative overflow-hidden rounded-2xl p-8 md:p-12 lg:col-span-5\"><div class=\"gold-foil absolute -right-12 -top-12 h-64 w-64 rounded-full opacity-10\" aria-hidden=\"true\"></div><div class=\"smallcaps relative mb-3 text-[10px] text-gold-dark\">Primary — Navy / Gold</div><div class=\"relative flex justify-center\"><img alt=\"EarnedStar 3D leather badge\" loading=\"lazy\" width=\"320\" height=\"320\" decoding=\"async\" data-nimg=\"1\" class=\"max-w-full drop-shadow-[0_24px_50px_rgba(11,26,56,0.32)]\" style=\"color:transparent\" src=\"/marketing/es-hero-badge.png\"/></div><h3 class=\"font-heading mt-6 text-center text-3xl leading-tight italic\">The EarnedStar mark.</h3></div><div class=\"vellum-card relative overflow-hidden rounded-2xl p-8 md:p-10 lg:col-span-7\"><div class=\"mb-5 flex items-center justify-between\"><div class=\"smallcaps text-[10px] text-gold-dark\">Brand System · Edition I</div><div class=\"font-num smallcaps text-[10px] text-ink/40\">Vol. 01 · 2026</div></div><img alt=\"EarnedStar full brand system — primary logo, icon detail, dark version, color variants\" loading=\"lazy\" width=\"900\" height=\"600\" decoding=\"async\" data-nimg=\"1\" class=\"h-auto w-full rounded-xl drop-shadow-[0_20px_40px_rgba(11,26,56,0.16)]\" style=\"color:transparent\" src=\"/marketing/es004-nano-banana.png\"/></div></div><div class=\"mt-12 grid grid-cols-1 gap-6 md:grid-cols-2\"><div class=\"vellum-card rounded-2xl p-10 text-center\" style=\"background:radial-gradient(ellipse at top, #FEF3C7 0%, #FFFFFF 60%)\"><div class=\"smallcaps mb-2 text-[10px] text-gold-dark\">Quarterly Leaders Award</div><h4 class=\"font-heading text-3xl italic\">For merchants who earn it.</h4><div class=\"mt-6 flex justify-center\"><img alt=\"EarnedStar Q1 Leader Award\" loading=\"lazy\" width=\"280\" height=\"280\" decoding=\"async\" data-nimg=\"1\" class=\"max-w-full\" style=\"color:transparent\" src=\"/marketing/es005-nano-banana.png\"/></div></div><div class=\"vellum-card rounded-2xl p-10 text-center\" style=\"background:radial-gradient(ellipse at top, #DBEAFE 0%, #FFFFFF 60%)\"><div class=\"smallcaps mb-2 text-[10px] text-gold-dark\">Anti-AI · Phase I</div><h4 class=\"font-heading text-3xl italic\">Verified Human.</h4><div class=\"mt-6 flex justify-center\"><img alt=\"EarnedStar Verified Human badge\" loading=\"lazy\" width=\"280\" height=\"280\" decoding=\"async\" data-nimg=\"1\" class=\"max-w-full\" style=\"color:transparent\" src=\"/marketing/es006-nano-banana.png\"/></div></div></div><div class=\"mt-12 grid grid-cols-1 gap-6 md:grid-cols-2\"><div class=\"vellum-card flex min-h-[220px] items-center justify-center rounded-2xl p-10\" style=\"background:linear-gradient(180deg, #FFFFFF 0%, #F7F4EE 100%)\"><img alt=\"EarnedStar leather wordmark\" loading=\"lazy\" width=\"400\" height=\"200\" decoding=\"async\" data-nimg=\"1\" class=\"max-h-52 w-auto object-contain\" style=\"color:transparent\" src=\"/marketing/es002-nano-banana.png\"/></div><div class=\"vellum-card flex min-h-[220px] items-center justify-center rounded-2xl p-10\" style=\"background:linear-gradient(180deg, #FFFFFF 0%, #F7F4EE 100%)\"><img alt=\"No order, no star. Every review is real.\" loading=\"lazy\" width=\"400\" height=\"200\" decoding=\"async\" data-nimg=\"1\" class=\"max-h-52 w-auto object-contain\" style=\"color:transparent\" src=\"/marketing/es003-nano-banana.png\"/></div></div></div></section><section id=\"live-review\" class=\"relative overflow-hidden bg-ink py-20 md:py-28\" data-surface=\"dark\"><div class=\"grain-overlay absolute inset-0 opacity-40\" aria-hidden=\"true\"></div><div class=\"relative mx-auto max-w-lg px-6 sm:px-10 lg:px-14\"><p class=\"smallcaps mb-2 text-center text-[10px] text-gold-light\">Live review</p><h2 class=\"mb-8 text-center font-heading text-3xl text-white sm:text-4xl\">See why stores trust <em class=\"text-gold-light\">EarnedStar</em></h2><div class=\"w-full max-w-md overflow-visible\" style=\"opacity:0;transform:translateY(24px) scale(0.96)\"><div class=\"gold-seam overflow-hidden rounded-2xl card-surface-dark bg-dark-bg/90 shadow-[0_4px_12px_rgba(0,0,0,0.35),0_24px_56px_rgba(0,0,0,0.45)]\" data-surface=\"dark\" style=\"opacity:0;transform:translateY(8px)\"><div class=\"h-1 bg-gradient-to-r from-navy via-gold to-navy\"></div><div class=\"p-6 sm:p-7\"><div class=\"mb-4 flex items-center justify-between gap-3\"><div class=\"flex items-center gap-2\"><span class=\"relative inline-block shrink-0\" style=\"width:28px;height:28px\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" overflow=\"visible\" aria-hidden=\"true\"><defs><filter id=\"ds-_R_19lred5ftb_\" x=\"-55%\" y=\"-45%\" width=\"210%\" height=\"210%\"><feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"0.8663200000000001\" result=\"b1\"></feGaussianBlur><feOffset in=\"b1\" dx=\"0.18563999999999997\" dy=\"2.3514399999999998\" result=\"off1\"></feOffset><feFlood flood-color=\"#00010f\" flood-opacity=\"0.7\" result=\"c1\"></feFlood><feComposite in=\"c1\" in2=\"off1\" operator=\"in\" result=\"sh1\"></feComposite><feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"2.4752\" result=\"b2\"></feGaussianBlur><feOffset in=\"b2\" dx=\"0\" dy=\"3.7127999999999997\" result=\"off2\"></feOffset><feFlood flood-color=\"#00010f\" flood-opacity=\"0.25\" result=\"c2\"></feFlood><feComposite in=\"c2\" in2=\"off2\" operator=\"in\" result=\"sh2\"></feComposite><feMerge><feMergeNode in=\"sh2\"></feMergeNode><feMergeNode in=\"sh1\"></feMergeNode><feMergeNode in=\"SourceGraphic\"></feMergeNode></feMerge></filter><radialGradient id=\"bg-_R_19lred5ftb_