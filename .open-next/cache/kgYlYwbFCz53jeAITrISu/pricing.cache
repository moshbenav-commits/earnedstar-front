rue\">★</span><span>1 widget</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold-dark\" aria-hidden=\"true\">★</span><span>1 user seat</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold-dark\" aria-hidden=\"true\">★</span><span>1 domain</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold-dark\" aria-hidden=\"true\">★</span><span>EarnedStar branding on widgets/emails</span></li></ul><a class=\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-navy text-white hover:bg-navy-mid border-transparent h-10 px-5 text-sm mt-8 w-full\" href=\"/contact\">Contact us</a></div></div><div class=\"relative flex flex-col rounded-2xl border bg-white shadow-[0_4px_12px_rgba(15,32,68,0.08),0_16px_40px_rgba(15,32,68,0.06)] border-border\" style=\"opacity:0;transform:translateY(20px)\"><div class=\"h-1 rounded-t-2xl bg-gradient-to-r from-navy/20 via-border to-navy/20\"></div><div class=\"flex flex-1 flex-col p-6 pt-7\"><div class=\"flex items-center gap-2\"><h3 class=\"text-lg font-bold capitalize text-navy\">starter</h3></div><p class=\"mt-2 text-3xl font-extrabold tracking-tight text-navy\">$<!-- -->29<span class=\"text-sm font-normal text-text-muted\">/mo</span></p><p class=\"mt-2 text-sm text-text-muted\">Perfect for stores just getting started</p><ul class=\"mt-6 flex-1 space-y-2.5\"><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold-dark\" aria-hidden=\"true\">★</span><span>200 invitations/month</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold-dark\" aria-hidden=\"true\">★</span><span>Verified by Purchase badge</span></li><li class=\"flex gap-2.5 text-sm text-text-muted\"><span class=\"mt-0.5 text-gold-dark\" aria-hidden=\"true\">★</span><span>Photo reviews</