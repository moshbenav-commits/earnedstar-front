se]],\"m\":\"$undefined\",\"G\":[\"$e\",[\"$Lf\",\"$L10\",\"$L11\"]],\"S\":true,\"h\":null,\"s\":\"$undefined\",\"l\":\"$undefined\",\"p\":\"$undefined\",\"d\":\"$undefined\",\"b\":\"kgYlYwbFCz53jeAITrISu\"}\n13:I[25281,[\"/_next/static/chunks/0cxz40551t56w.js\",\"/_next/static/chunks/0mjm82_pbopny.js\"],\"OutletBoundary\"]\n14:\"$Sreact.suspense\"\n17:I[25281,[\"/_next/static/chunks/0cxz40551t56w.js\",\"/_next/static/chunks/0mjm82_pbopny.js\"],\"ViewportBoundary\"]\n19:I[25281,[\"/_next/static/chunks/0cxz40551t56w.js\",\"/_next/static/chunks/0mjm82_pbopny.js\"],\"MetadataBoundary\"]\nb:[\"$\",\"$1\",\"c\",{\"children\":[\"$L12\",[[\"$\",\"script\",\"script-0\",{\"src\":\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-1\",{\"src\":\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"async\":true,\"nonce\":\"$undefined\"}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/1i54d9w-76kdn.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"$L13\",null,{\"children\":[\"$\",\"$14\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@15\"}]}]]}]\n16:[]\nc:\"$W16\"\nd:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L17\",null,{\"children\":\"$L18\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$14\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1a\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nf:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/04ck2bxtd1egb.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n10:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0qv2wjfea2o4h.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n11:[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/456tflun7xfy4.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1b:I[24510,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"MarketingNav\"]\n12:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-cream text-ink antialiased\",\"data-scroll-theme\":\"light\",\"children\":[[\"$\",\"$L1b\",null,{}],[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-3xl px-4 py-16 sm:px-6\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Trust and reputation\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":[4,\" min read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold text-navy sm:text-4xl\",\"children\":\"What actually counts as a \\\"verified purchase\\\" review\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-lg leading-relaxed text-text-muted\",\"children\":\"\\\"Verified purchase\\\" gets used loosely across review platforms. Here's what the label should actually require, and why the gap matters for buyer trust.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 space-y-5 text-base leading-relaxed text-ink\",\"children\":[[\"$\",\"h1\",\"block-0\",{\"className\":\"text-2xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-0-0\",{\"children\":\"What actually counts as a \\\"verified purchase\\\" review\"}]]}],[\"$\",\"p\",\"block-1\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-1-0\",{\"children\":\"Quick answer.\"}],[\"$\",\"span\",\"block-1-1\",{\"children\":\" \\\"Verified purchase\\\" should mean one thing: the review is tied to a confirmed, completed order between that reviewer and that seller. Many platforms stretch the label to cover looser signals — a logged-in account, an email match, a self-reported claim — that confirm far less. That gap determines how much weight the badge should actually carry.\"}]]}],[\"$\",\"h2\",\"block-2\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-2-0\",{\"children\":\"What does \\\"verified purchase\\\" actually require?\"}]]}],[\"$\",\"p\",\"block-3\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-3-0\",{\"children\":\"At minimum, three things have to line up: a real order record, a specific product on that order, and a reviewer identity matched to the person who placed it. If any one of those is missing, the review might still be genuine, but it isn't verified in the sense the label implies.\"}]]}],[\"$\",\"p\",\"block-4\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-4-0\",{\"children\":\"This is a narrower bar than it sounds. It rules out reviews from someone who received the product as a gift, a sample, or a resale, unless the platform can trace the transaction back to an actual purchase. It also rules out a review submitted by anyone simply willing to click \\\"I bought this.\\\"\"}]]}],[\"$\",\"h2\",\"block-5\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-5-0\",{\"children\":\"Why do platforms use the label so inconsistently?\"}]]}],[\"$\",\"p\",\"block-6\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-6-0\",{\"children\":\"Because the strict version is expensive to build and the loose version isn't.\"}]]}],[\"$\",\"p\",\"block-7\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-7-0\",{\"children\":\"Matching a review to a real order requires order data — something a review platform only has if it's actually wired into checkout or fulfillment systems. Plenty of review tools operate independently of that data, so they substitute something easier to check: an email address that matches a receipt someone uploaded, an account that's simply logged in, or nothing more than a checkbox the reviewer ticks themselves. All of it gets called \\\"verified,\\\" and the badge looks identical regardless of which standard produced it.\"}]]}],[\"$\",\"p\",\"block-8\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-8-0\",{\"children\":\"The result is a word that's stopped doing the job it's supposed to do. A shopper who trusts the badge is trusting a claim they have no way to audit.\"}]]}],\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\"]}],\"$L2c\",\"$L2d\",\"$L2e\"]}],\"$L2f\"]}]\n31:I[97801,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"EarnedStarOutlineStar\"]\n1c:[\"$\",\"h2\",\"block-9\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-9-0\",{\"children\":\"What's the difference between a verified badge and an honest review?\"}]]}]\n1d:[\"$\",\"p\",\"block-10\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-10-0\",{\"children\":\"Verification and honesty solve two different problems, and conflating them is where most of the confusion starts.\"}]]}]\n1e:[\"$\",\"p\",\"block-11\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-11-0\",{\"children\":\"Verification answers: did this transaction happen? Honesty answers: is this review an accurate account of that experience? A review can be fully verified and still be shaped by an incentive, written under pressure from a support interaction, or softened because the reviewer didn't want to seem difficult. None of that shows up in a badge that only checks for a matched order.\"}]]}]\n1f:[\"$\",\"div\",\"block-12\",{\"className\":\"overflow-x-auto rounded-lg border border-border\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full border-collapse text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-surface\",\"children\":[[\"$\",\"th\",\"block-12-h-0\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-h-0-0\",{\"children\":\"Question\"}]]}],[\"$\",\"th\",\"block-12-h-1\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-h-1-0\",{\"children\":\"What verification answers\"}]]}],[\"$\",\"th\",\"block-12-h-2\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-h-2-0\",{\"children\":\"What it doesn't answer\"}]]}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"block-12-r-0\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-0-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-0-0-0\",{\"children\":\"Did a real transaction occur?\"}]]}],[\"$\",\"td\",\"block-12-r-0-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-0-1-0\",{\"children\":\"Yes, if matched to order data\"}]]}],[\"$\",\"td\",\"block-12-r-0-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-0-2-0\",{\"children\":\"—\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-1\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-1-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-1-0-0\",{\"children\":\"Did this specific person buy it?\"}]]}],[\"$\",\"td\",\"block-12-r-1-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-1-1-0\",{\"children\":\"Yes, if identity is matched\"}]]}],[\"$\",\"td\",\"block-12-r-1-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-1-2-0\",{\"children\":\"—\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-2\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-2-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-2-0-0\",{\"children\":\"Is the review's content accurate?\"}]]}],[\"$\",\"td\",\"block-12-r-2-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-2-1-0\",{\"children\":\"Not addressed\"}]]}],[\"$\",\"td\",\"block-12-r-2-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-2-2-0\",{\"children\":\"Requires separate moderation\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-3\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-3-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-3-0-0\",{\"children\":\"Was the review incentivized?\"}]]}],[\"$\",\"td\",\"block-12-r-3-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-3-1-0\",{\"children\":\"Not addressed\"}]]}],[\"$\",\"td\",\"block-12-r-3-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-3-2-0\",{\"children\":\"Requires disclosure policy\"}]]}]]}]]}]]}]}]\n20:[\"$\",\"p\",\"block-13\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-13-0\",{\"children\":\"A serious review program needs both layers: verification at collection, and a separate set of rules — no incentives tied to sentiment, no filtering by expected rating — governing what happens after.\"}]]}]\n21:[\"$\",\"h2\",\"block-14\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-14-0\",{\"children\":\"How can a merchant check what their own platform's badge really means?\"}]]}]\n22:[\"$\",\"p\",\"block-15\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-15-0\",{\"children\":\"Ask the platform one direct question: what specific data point triggers the verified label? If the answer traces back to an actual order record matched to the reviewer, the badge means what shoppers assume it means. If the answer is softer — a logged-in account, a self-reported claim, an email that merely looks plausible — the badge is decoration, and shoppers are trusting something the platform can't actually back up.\"}]]}]\n23:[\"$\",\"p\",\"block-16\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-16-0\",{\"children\":\"It's worth checking this even on a platform already in use. A badge inherited from a default configuration, never audited, can end up meaning far less than whoever set it up assumed.\"}]]}]\n24:[\"$\",\"h2\",\"block-17\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-17-0\",{\"children\":\"What should a shopper look for beyond the badge itself?\"}]]}]\n25:[\"$\",\"p\",\"block-18\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-18-0\",{\"children\":\"Specificity. A verified badge on a review that says \\\"great product, love it\\\" carries less useful signal than an unverified review that describes exact fit, use case, or a specific flaw. The badge confirms the transaction; it doesn't confirm the review is worth reading.\"}]]}]\n26:[\"$\",\"p\",\"block-19\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-19-0\",{\"children\":\"The two checks work together, not as substitutes for each other — a verified, specific review is the strongest signal a shopper can act on, and neither check alone gets there.\"}]]}]\n27:[\"$\",\"h2\",\"block-20\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-20-0\",{\"children\":\"Frequently asked questions\"}]]}]\n28:[\"$\",\"p\",\"block-21\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-21-0\",{\"children\":\"What does \\\"verified purchase\\\" mean, in the strictest sense?\"}],[\"$\",\"span\",\"block-21-1\",{\"children\":\" A review tied to a confirmed, completed transaction between the specific reviewer and the specific seller — not a purchase somewhere else, not an account that merely exists, and not a claim the platform never checked.\"}]]}]\n29:[\"$\",\"p\",\"block-22\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-22-0\",{\"children\":\"Does a verified badge guarantee the review is honest?\"}],[\"$\",\"span\",\"block-22-1\",{\"children\":\" No. Verification confirms a transaction happened. It says nothing about whether the review was incentivized, coached, or written by someone other than the buyer. Verification and honesty are separate problems solved by separate controls.\"}]]}]\n2a:[\"$\",\"p\",\"block-23\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-23-0\",{\"children\":\"Why do so many platforms use \\\"verified\\\" loosely?\"}],[\"$\",\"span\",\"block-23-1\",{\"children\":\" Because a looser standard is cheaper to build and produces more reviews faster. Confirming a real, matched transaction requires order data most open platforms never collect, so many settle for weaker signals — an email confirmation, a logged-in account — and label the result \\\"verified\\\" anyway.\"}]]}]\n2b:[\"$\",\"p\",\"block-24\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-24-0\",{\"children\":\"What should a merchant check before trusting a \\\"verified\\\" badge on their own review platform?\"}],[\"$\",\"span\",\"block-24-1\",{\"children\":\" Ask what specific data point triggers the label. If the answer is anything short of \\\"a completed order record matched to this reviewer,\\\" the badge is marketing language, not a verification claim a shopper should be able to rely on.\"}]]}]\n2c:[\"$\",\"section\",null,{\"className\":\"mt-12 border-t border-border pt-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted\",\"children\":\"Sources\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://www.ftc.gov/business-guidance/resources/consumer-reviews-testimonials-rule-questions-answers\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.ftc.gov/business-guidance/resources/consumer-reviews-testimonials-rule-questions-answers\",\"rel\":\"noopener noreferrer nofollow\",\"target\":\"_blank\",\"className\":\"break-all text-navy-light hover:underline\",\"children\":\"https://www.ftc.gov/business-guidance/resources/consumer-reviews-testimonials-rule-questions-answers\"}]}]]}]]}]\n2d:[\"$\",\"p\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/blog\",\"className\":\"text-sm text-text-muted hover:text-navy hover:underline\",\"children\":\"← All articles\"}]}]\n30:T656,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does \\\"verified purchase\\\" mean, in the strictest sense?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A review tied to a confirmed, completed transaction between the specific reviewer and the specific seller — not a purchase somewhere else, not an account that merely exists, and not a claim the platform never checked.\"}},{\"@type\":\"Question\",\"name\":\"Does a verified badge guarantee the review is honest?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Verification confirms a transaction happened. It says nothing about whether the review was incentivized, coached, or written by someone other than the buyer. Verification and honesty are separate problems solved by separate controls.\"}},{\"@type\":\"Question\",\"name\":\"Why do so many platforms use \\\"verified\\\" loosely?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Because a looser standard is cheaper to build and produces more reviews faster. Confirming a real, matched transaction requires order data most open platforms never collect, so many settle for weaker signals — an email confirmation, a logged-in account — and label the result \\\"verified\\\" anyway.\"}},{\"@type\":\"Question\",\"name\":\"What should a merchant check before trusting a \\\"verified\\\" badge on their own review platform?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Ask what specific data point triggers the label. If the answer is anything short of \\\"a completed order record matched to this reviewer,\\\" the badge is marketing language, not a verification claim a shopper should be able to rely on.\"}}]}2e:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$30\"}}]\n2f:[\"$\",\"footer\",null,{\"className\":\"border-t border-border bg-navy text-white\",\"data-scroll-theme\":\"dark\",\"children\":[[\"$\",\"section\",null,{\"className\":\"py-20 text-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl italic text-gold\",\"children\":\"Stop guessing if customers trust you.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-white/70\",\"children\":\"Show them proof. 1,200+ stores collect verified reviews with EarnedStar.\"}],[\"$\",\"$La\",null,{\"href\":\"/signup\",\"className\":\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-gold text-ink hover:bg-gold-light border-transparent shadow-[var(--shadow-gold)] h-12 px-6 text-base mt-8\",\"children\":\"Start Your Free Trial →\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl border-t border-white/10 px-4 py-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-2\",\"chil