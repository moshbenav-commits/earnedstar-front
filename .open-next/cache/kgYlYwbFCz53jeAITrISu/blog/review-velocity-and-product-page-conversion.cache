children\":[[\"$\",\"li\",\"/privacy\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/privacy\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Privacy\"}]}],[\"$\",\"li\",\"/terms\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/terms\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Terms\"}]}],[\"$\",\"li\",\"/accessibility\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/accessibility\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Accessibility\"}]}]]}]]}]\n34:[\"$\",\"div\",null,{\"className\":\"mt-10 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L36\",null,{\"partnerName\":\"EarnedStar\",\"partnerInitial\":\"E\",\"size\":\"sm\",\"surface\":\"dark\"}]}]\n35:[\"$\",\"p\",null,{\"className\":\"mt-4 text-xs text-white/60\",\"children\":\"© 2026 EarnedStar, Inc. · Los Angeles, CA\"}]\n19:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n37:I[18067,[\"/_next/static/chunks/0cxz40551t56w.js\",\"/_next/static/chunks/0mjm82_pbopny.js\"],\"IconMark\"]\n16:null\n1b:[[\"$\",\"title\",\"0\",{\"children\":\"How review velocity shapes conversion on a product page — EarnedStar | EarnedStar\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"A product with a steady flow of new reviews reads differently than one with a stale pile from a year ago. Here's why velocity, not just count, moves conversion.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/site.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://earnedstar.com/blog/review-velocity-and-product-page-conversion\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"How review velocity shapes conversion on a product page\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"A product with a steady flow of new reviews reads differently than one with a stale pile from a year ago. Here's why velocity, not just count, moves conversion.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://earnedstar.com/blog/review-velocity-and-product-page-conversion\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:site_name\",\"content\":\"EarnedStar\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"How review velocity shapes conversion on a product page\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"A product with a steady flow of new reviews reads differently than one with a stale pile from a year ago. Here's why velocity, not just count, moves conversion.\"}],[\"$\",\"link\",\"12\",{\"rel\":\"icon\",\"href\":\"/icon\",\"sizes\":\"32x32\",\"type\":\"image/png\"}],[\"$\",\"link\",\"13\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon\",\"sizes\":\"180x180\",\"type\":\"image/png\"}],[\"$\",\"$L37\",\"14\",{}]]\n","/blog/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[24510,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"MarketingNav\"]\n1b:I[86696,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"\"]\n1d:I[97801,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"EarnedStarOutlineStar\"]\n1e:I[97801,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"EarnedStarWordmark\"]\n22:I[25281,[\"/_next/static/chunks/0cxz40551t56w.js\",\"/_next/static/chunks/0mjm82_pbopny.js\"],\"OutletBoundary\"]\n23:\"$Sreact.suspense\"\n25:I[2437,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"CreytixPartnerLockup\"]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-cream text-ink antialiased\",\"data-scroll-theme\":\"light\",\"children\":[[\"$\",\"$L2\",null,{}],[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-3xl px-4 py-16 sm:px-6\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Reviews and conversion\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":[5,\" min read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold text-navy sm:text-4xl\",\"children\":\"How review velocity shapes conversion on a product page\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-lg leading-relaxed text-text-muted\",\"children\":\"A product with a steady flow of new reviews reads differently than one with a stale pile from a year ago. Here's why velocity, not just count, moves conversion.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 space-y-5 text-base leading-relaxed text-ink\",\"children\":[[\"$\",\"h1\",\"block-0\",{\"className\":\"text-2xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-0-0\",{\"children\":\"How review velocity shapes conversion on a product page\"}]]}],[\"$\",\"p\",\"block-1\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-1-0\",{\"children\":\"Quick answer.\"}],[\"$\",\"span\",\"block-1-1\",{\"children\":\" Review velocity — how often new reviews land, not the total count — shapes conversion because shoppers read recency as relevance. A steady trickle of fresh reviews reads as actively bought and true right now; a large pile that stopped growing months ago reads as a snapshot of the past, even at the same average rating.\"}]]}],[\"$\",\"h2\",\"block-2\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-2-0\",{\"children\":\"What is review velocity, and how is it different from review count?\"}]]}],[\"$\",\"p\",\"block-3\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-3-0\",{\"children\":\"Count is a total. Velocity is a rate — how frequently new reviews arrive relative to how long the product has been listed.\"}]]}],[\"$\",\"p\",\"block-4\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-4-0\",{\"children\":\"Two products can carry the identical count and read completely differently. A product with 150 reviews, the last one posted eleven months ago, tells a shopper the review activity has gone quiet. A product with 150 reviews, ten of them from the last month, tells a shopper the product is still being bought and still holding up under current scrutiny. Same number. Different signal.\"}]]}],[\"$\",\"h2\",\"block-5\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-5-0\",{\"children\":\"Why does recency change how a shopper reads the reviews?\"}]]}],[\"$\",\"p\",\"block-6\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-6-0\",{\"children\":\"Because a shopper isn't asking \\\"did this used to work.\\\" They're asking \\\"does this work now.\\\"\"}]]}],[\"$\",\"p\",\"block-7\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-7-0\",{\"children\":\"Products change — a supplier switches, a manufacturing run shifts, packaging gets redesigned, a formula gets tweaked. None of that necessarily shows up anywhere on the page except in how recent the reviews are. A large batch of old reviews describes a version of the product a shopper can't be sure they're about to receive. A handful of current reviews describes what's shipping this week.\"}]]}],[\"$\",\"p\",\"block-8\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-8-0\",{\"children\":\"That's also why review count alone is a weaker predictor than it looks. A product can accumulate reviews for years and still stall on velocity the moment attention moves elsewhere — new SKUs, a redesign, a marketing push somewhere else — and conversion tends to follow that stall down even while the total count keeps climbing on paper.\"}]]}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\"]}],\"$L13\",\"$L14\",\"$L15\"]}],\"$L16\"]}],[\"$L17\",\"$L18\",\"$L19\"],\"$L1a\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"kgYlYwbFCz53jeAITrISu\"}\n3:[\"$\",\"h2\",\"block-9\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-9-0\",{\"children\":\"Can more reviews, arriving faster, ever work against a product?\"}]]}]\n4:[\"$\",\"p\",\"block-10\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-10-0\",{\"children\":\"Yes — if what's arriving is bad news.\"}]]}]\n5:[\"$\",\"p\",\"block-11\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-11-0\",{\"children\":\"Velocity cuts both ways. A rising rate of fresh, specific complaints is a faster and more visible signal to a shopper than the same complaints diluted into a large historical average. A product with a sudden run of one- and two-star reviews in the last two weeks, even sitting on a decent lifetime average, is telling a shopper something urgent is happening right now — a defect, a supply issue, a change nobody announced.\"}]]}]\n6:[\"$\",\"p\",\"block-12\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-12-0\",{\"children\":\"This is actually the useful side of tracking velocity: it surfaces a real problem faster than a slow-moving average ever would, giving a merchant a chance to catch and fix it before it becomes the defining story of the product.\"}]]}]\n7:[\"$\",\"h2\",\"block-13\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-13-0\",{\"children\":\"What actually drives review velocity, in practice?\"}]]}]\n8:[\"$\",\"p\",\"block-14\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-14-0\",{\"children\":\"Not a single campaign — a consistent process running behind every order.\"}]]}]\n9:[\"$\",\"div\",\"block-15\",{\"className\":\"overflow-x-auto rounded-lg border border-border\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full border-collapse text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-surface\",\"children\":[[\"$\",\"th\",\"block-15-h-0\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-15-h-0-0\",{\"children\":\"Approach\"}]]}],[\"$\",\"th\",\"block-15-h-1\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-15-h-1-0\",{\"children\":\"Effect on velocity\"}]]}],[\"$\",\"th\",\"block-15-h-2\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-15-h-2-0\",{\"children\":\"Trade-off\"}]]}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"block-15-r-0\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-15-r-0-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-0-0-0\",{\"children\":\"One bulk request campaign, run occasionally\"}]]}],[\"$\",\"td\",\"block-15-r-0-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-0-1-0\",{\"children\":\"A spike, then silence\"}]]}],[\"$\",\"td\",\"block-15-r-0-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-0-2-0\",{\"children\":\"Looks stale again within weeks\"}]]}]]}],[\"$\",\"tr\",\"block-15-r-1\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-15-r-1-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-1-0-0\",{\"children\":\"A request sent at a consistent point after every delivery\"}]]}],[\"$\",\"td\",\"block-15-r-1-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-1-1-0\",{\"children\":\"A steady, ongoing trickle\"}]]}],[\"$\",\"td\",\"block-15-r-1-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-1-2-0\",{\"children\":\"Requires the request to actually run on every order\"}]]}]]}],[\"$\",\"tr\",\"block-15-r-2\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-15-r-2-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-2-0-0\",{\"children\":\"Requests sent only to customers expected to respond well\"}]]}],[\"$\",\"td\",\"block-15-r-2-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-2-1-0\",{\"children\":\"A flattering but thin, irregular flow\"}]]}],[\"$\",\"td\",\"block-15-r-2-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-2-2-0\",{\"children\":\"Produces a biased sample, not real velocity\"}]]}]]}],[\"$\",\"tr\",\"block-15-r-3\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-15-r-3-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-3-0-0\",{\"children\":\"No systematic request process\"}]]}],[\"$\",\"td\",\"block-15-r-3-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-3-1-0\",{\"children\":\"Velocity depends entirely on unprompted reviewers\"}]]}],[\"$\",\"td\",\"block-15-r-3-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-15-r-3-2-0\",{\"children\":\"Almost always the slowest and least representative option\"}]]}]]}]]}]]}]}]\na:[\"$\",\"p\",\"block-16\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-16-0\",{\"children\":\"The pattern underneath: velocity isn't something to chase with a burst of effort. It's a byproduct of asking every customer, at a predictable moment, every time an order closes.\"}]]}]\nb:[\"$\",\"h2\",\"block-17\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-17-0\",{\"children\":\"What should a merchant actually watch, beyond the average rating?\"}]]}]\nc:[\"$\",\"p\",\"block-18\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-18-0\",{\"children\":\"The trend line, not just the number.\"}]]}]\nd:[\"$\",\"p\",\"block-19\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-19-0\",{\"children\":\"A rating average is a lagging summary. Velocity — how many reviews land per week or month, and which direction the sentiment inside them is moving — is a leading indicator. Watching it catches a supply problem or a shipping delay while it's still small, instead of finding out three months later that the average quietly slid while nobody was checking the pace of what was coming in.\"}]]}]\ne:[\"$\",\"h2\",\"block-20\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-20-0\",{\"children\":\"Frequently asked questions\"}]]}]\nf:[\"$\",\"p\",\"block-21\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-21-0\",{\"children\":\"What does \\\"review velocity\\\" mean?\"}],[\"$\",\"span\",\"block-21-1\",{\"children\":\" The rate at which new reviews land on a product over time, as opposed to the total count sitting on the page. A product with 200 reviews and none in the last eight months has a different velocity than one adding a handful every week, even at the same total.\"}]]}]\n10:[\"$\",\"p\",\"block-22\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-22-0\",{\"children\":\"Why does a steady flow of new reviews matter more than a big one-time batch?\"}],[\"$\",\"span\",\"block-22-1\",{\"children\":\" Because shoppers read recency as a proxy for whether the product is still what the reviews describe. A pile of reviews from two years ago says less about the product being sold today than five reviews from the last month do.\"}]]}]\n11:[\"$\",\"p\",\"block-23\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-23-0\",{\"children\":\"Can review velocity ever hurt conversion?\"}],[\"$\",\"span\",\"block-23-1\",{\"children\":\" Yes, if the recent reviews are trending negative. A rising rate of fresh complaints is a faster, clearer signal to a shopper than the same complaints buried in an old average — which is exactly why velocity should be watched, not just accumulated.\"}]]}]\n12:[\"$\",\"p\",\"block-24\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-24-0\",{\"children\":\"How does a merchant actually influence review velocity?\"}],[\"$\",\"span\",\"block-24-1\",{\"children\":\" By requesting a review from every completed order at a consistent point after delivery, rather than running occasional bulk campaigns. Steady requests produce a steady trickle of new reviews; sporadic campaigns produce spikes followed by long silences.\"}]]}]\n13:[\"$\",\"section\",null,{\"className\":\"mt-12 border-t border-border pt-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted\",\"children\":\"Sources\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://wiremo.co/business/ratings-and-reviews-affect-conversion-rates/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://wiremo.co/business/ratings-and-reviews-affect-conversion-rates/\",\"rel\":\"noopener noreferrer nofollow\",\"target\":\"_blank\",\"className\":\"break-all text-navy-light hover:underline\",\"children\":\"https://wiremo.co/business/ratings-and-reviews-affect-conversion-rates/\"}]}]]}]]}]\n14:[\"$\",\"p\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"$L1b\",null,{\"href\":\"/blog\",\"className\":\"text-sm text-text-muted hover:text-navy hover:underline\",\"children\":\"← All articles\"}]}]\n1c:T61b,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What does \\\"review velocity\\\" mean?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The rate at which new reviews land on a product over time, as opposed to the total count sitting on the page. A product with 200 reviews and none in the last eight months has a different velocity than one adding a handful every week, even at the same total.\"}},{\"@type\":\"Question\",\"name\":\"Why does a steady flow of new reviews matter more than a big one-time batch?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Because shoppers read recency as a proxy for whether the product is still what the reviews describe. A pile of reviews from two years ago says less about the product being sold today than five reviews from the last month do.\"}},{\"@type\":\"Question\",\"name\":\"Can review velocity ever hurt conversion?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes, if the recent reviews are trending negative. A rising rate of fresh complaints is a faster, clearer signal to a shopper than the same complaints buried in an old average — which is exactly why velocity should be watched, not just accumulated.\"}},{\"@type\":\"Question\",\"name\":\"How does a merchant actually influence review velocity?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"By requesting a review from every completed order at a consistent point after delivery, rather than running occasional bulk campaigns. Steady requests produce a steady trickle of new reviews; sporadic campaigns produce spikes followed by long silences.\"}}]}15:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1c\"}}]\n16:[\"$\",\"footer\",null,{\"className\":\"border-t border-border bg-navy text-white\",\"data-scroll-theme\":\"dark\",\"children\":[[\"$\",\"section\",null,{\"className\":\"py-20 text-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl italic text-gold\",\"children\":\"Stop guessing if customers trust you.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-white/70\",\"children\":\"Show them proof. 1,200+ stores collect verified reviews with EarnedStar.\"}],[\"$\",\"$L1b\",null,{\"href\":\"/signup\",\"className\":\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-gold text-ink hover:bg-gold-light border-transparent shadow-[var(--shadow-gold)] h-12 px-6 text-base mt-8\",\"children\":\"Start Your Free Trial →\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl border-t border-white/10 px-4 py-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"$L1d\",null,{\"size\":37,\"showBadge\":false}],[\"$\",\"$L1e\",null,{\"size\":40,\"onDark\":true}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 max-w-xs text-sm text-white/60\",\"children\":\"Verified reviews for e-commerce stores that take trust seriously.\"}]]}],[[\"$\",\"nav\",\"Product