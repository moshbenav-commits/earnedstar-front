d\"}],[\"$\",\"script\",\"script-2\",{\"src\":\"/_next/static/chunks/1i54d9w-76kdn.js\",\"async\":true,\"nonce\":\"$undefined\"}]],[\"$\",\"$L13\",null,{\"children\":[\"$\",\"$14\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@15\"}]}]]}]\n16:[]\nc:\"$W16\"\nd:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L17\",null,{\"children\":\"$L18\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$14\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1a\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\nf:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/04ck2bxtd1egb.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n10:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0qv2wjfea2o4h.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n11:[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/456tflun7xfy4.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1b:I[24510,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"MarketingNav\"]\n12:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-cream text-ink antialiased\",\"data-scroll-theme\":\"light\",\"children\":[[\"$\",\"$L1b\",null,{}],[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-3xl px-4 py-16 sm:px-6\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Review response strategy\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":[5,\" min read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold text-navy sm:text-4xl\",\"children\":\"What to do about a negative review that's factually accurate\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-lg leading-relaxed text-text-muted\",\"children\":\"A bad review that's also true is harder to handle than a false one. Here's how a merchant should respond, fix, and follow up without pretending it didn't happen.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 space-y-5 text-base leading-relaxed text-ink\",\"children\":[[\"$\",\"h1\",\"block-0\",{\"className\":\"text-2xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-0-0\",{\"children\":\"What to do about a negative review that's factually accurate\"}]]}],[\"$\",\"p\",\"block-1\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-1-0\",{\"children\":\"Quick answer.\"}],[\"$\",\"span\",\"block-1-1\",{\"children\":\" A negative review that's also true can't be argued away or removed — only acknowledged and acted on. The right response confirms the specific problem and states what's being done about it, without disputing how the customer felt. The fix that matters most happens after the response, in whether the same complaint shows up again.\"}]]}],[\"$\",\"h2\",\"block-2\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-2-0\",{\"children\":\"Why is an accurate negative review harder to handle than a false one?\"}]]}],[\"$\",\"p\",\"block-3\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-3-0\",{\"children\":\"Because there's no factual ground to push back on.\"}]]}],[\"$\",\"p\",\"block-4\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-4-0\",{\"children\":\"A false review — one describing a purchase that never happened, or an experience invented outright — can usually be flagged, reported, or contested with the platform directly. An accurate review leaves none of those options open. The shipment really was late. The product really did arrive with a crack. Disputing an accurate account only makes the response look like denial, which reads worse to everyone watching than the original complaint did.\"}]]}],[\"$\",\"h2\",\"block-5\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-5-0\",{\"children\":\"What's the first thing to check before responding?\"}]]}],[\"$\",\"p\",\"block-6\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-6-0\",{\"children\":\"Whether the review is actually accurate, not whether it's fair.\"}]]}],[\"$\",\"p\",\"block-7\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-7-0\",{\"children\":\"Accuracy and fairness are different questions. A review can be completely accurate and still feel unfair — a customer describing a two-day shipping delay as \\\"the worst experience of my life\\\" is technically reporting something real, even if the framing is dramatic. The response should engage with the factual core, not the tone. Arguing about the tone is a losing move; it signals defensiveness instead of ownership.\"}]]}],[\"$\",\"h2\",\"block-8\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-8-0\",{\"children\":\"What should the public response actually contain?\"}]]}],[\"$\",\"p\",\"block-9\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-9-0\",{\"children\":\"Three things, in order: acknowledgment, specifics, and a concrete next step.\"}]]}],[\"$\",\"p\",\"block-10\",{\"className\":\"text-ink\",\"children\":[\"$L1c\",\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\"]}],\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\"]}],\"$L32\",\"$L33\",\"$L34\"]}],\"$L35\"]}]\n37:I[97801,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"EarnedStarOutlineStar\"]\n1c:[\"$\",\"span\",\"block-10-0\",{\"children\":\"- \"}]\n1d:[\"$\",\"strong\",\"block-10-1\",{\"children\":\"Acknowledge the specific issue\"}]\n1e:[\"$\",\"span\",\"block-10-2\",{\"children\":\", by name, not a vague \\\"we're sorry you   had a bad experience.\\\" A response that names the actual problem shows the   merchant read the review rather than pasted a template. - \"}]\n1f:[\"$\",\"strong\",\"block-10-3\",{\"children\":\"State what's being done about it\"}]\n20:[\"$\",\"span\",\"block-10-4\",{\"children\":\" — a refund, a replacement, a process   change — in terms specific enough that a future shopper reading the thread   understands the problem is being taken seriously, not just apologized for. - \"}]\n21:[\"$\",\"strong\",\"block-10-5\",{\"children\":\"Avoid re-litigating the account.\"}]\n22:[\"$\",\"span\",\"block-10-6\",{\"children\":\" Even where the merchant's version of   events differs slightly, a public reply is not the venue to argue the   details. Move that conversation to a direct channel and keep the public   response focused on ownership.\"}]\n23:[\"$\",\"div\",\"block-11\",{\"className\":\"overflow-x-auto rounded-lg border border-border\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full border-collapse text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-surface\",\"children\":[[\"$\",\"th\",\"block-11-h-0\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-11-h-0-0\",{\"children\":\"Response pattern\"}]]}],[\"$\",\"th\",\"block-11-h-1\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-11-h-1-0\",{\"children\":\"What it signals\"}]]}],[\"$\",\"th\",\"block-11-h-2\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-11-h-2-0\",{\"children\":\"Effect on future shoppers\"}]]}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"block-11-r-0\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-11-r-0-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-0-0-0\",{\"children\":\"Generic apology, no specifics\"}]]}],[\"$\",\"td\",\"block-11-r-0-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-0-1-0\",{\"children\":\"Templated, disengaged\"}]]}],[\"$\",\"td\",\"block-11-r-0-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-0-2-0\",{\"children\":\"Reads as damage control\"}]]}]]}],[\"$\",\"tr\",\"block-11-r-1\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-11-r-1-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-1-0-0\",{\"children\":\"Specific acknowledgment + fix offered\"}]]}],[\"$\",\"td\",\"block-11-r-1-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-1-1-0\",{\"children\":\"Taken seriously, handled\"}]]}],[\"$\",\"td\",\"block-11-r-1-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-1-2-0\",{\"children\":\"Reads as a company that responds\"}]]}]]}],[\"$\",\"tr\",\"block-11-r-2\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-11-r-2-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-2-0-0\",{\"children\":\"Disputing the reviewer's account publicly\"}]]}],[\"$\",\"td\",\"block-11-r-2-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-2-1-0\",{\"children\":\"Defensive\"}]]}],[\"$\",\"td\",\"block-11-r-2-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-2-2-0\",{\"children\":\"Reads worse than the original complaint\"}]]}]]}],[\"$\",\"tr\",\"block-11-r-3\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-11-r-3-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-3-0-0\",{\"children\":\"No response at all\"}]]}],[\"$\",\"td\",\"block-11-r-3-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-3-1-0\",{\"children\":\"Unaddressed\"}]]}],[\"$\",\"td\",\"block-11-r-3-2\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-11-r-3-2-0\",{\"children\":\"Reads as either absent or indifferent\"}]]}]]}]]}]]}]}]\n24:[\"$\",\"h2\",\"block-12\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-0\",{\"children\":\"Should a merchant try to get an accurate negative review taken down?\"}]]}]\n25:[\"$\",\"p\",\"block-13\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-13-0\",{\"children\":\"No. Most review platforms won't remove a review for being unflattering, and pursuing removal anyway — through repeated appeals, through pressure on the customer, through disputing verified purchase status that isn't actually in question — tends to surface publicly and reads far worse than the original review ever did.\"}]]}]\n26:[\"$\",\"p\",\"block-14\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-14-0\",{\"children\":\"The review staying up isn't the problem to solve. What it describes is.\"}]]}]\n27:[\"$\",\"h2\",\"block-15\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-15-0\",{\"children\":\"Does the response matter more than actually fixing the problem?\"}]]}]\n28:[\"$\",\"p\",\"block-16\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-16-0\",{\"children\":\"No — and this is the part easiest to get backwards. A well-crafted response to a shipping delay that happens again next month accomplishes nothing. The response buys a small amount of goodwill in the moment; whether that goodwill holds depends entirely on whether the next batch of reviews shows the same complaint or a different one.\"}]]}]\n29:[\"$\",\"p\",\"block-17\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-17-0\",{\"children\":\"Treat every accurate negative review as a free, specific bug report. The response handles the immediate relationship. The fix is what actually changes what future reviews say.\"}]]}]\n2a:[\"$\",\"h2\",\"block-18\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-18-0\",{\"children\":\"How should a merchant follow up after responding?\"}]]}]\n2b:[\"$\",\"p\",\"block-19\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-19-0\",{\"children\":\"Check whether the fix worked, using the next round of reviews as the test.\"}]]}]\n2c:[\"$\",\"p\",\"block-20\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-20-0\",{\"children\":\"If the same specific complaint — the same defect, the same delay, the same support failure — shows up again from a different customer, the underlying issue wasn't actually addressed, regardless of how the first response read. That recurrence is more informative than the original review was on its own, because it confirms whether the acknowledgment was followed by a real change or just a well-worded reply.\"}]]}]\n2d:[\"$\",\"h2\",\"block-21\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-21-0\",{\"children\":\"Frequently asked questions\"}]]}]\n2e:[\"$\",\"p\",\"block-22\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-22-0\",{\"children\":\"What makes a negative review \\\"factually accurate\\\" versus just harsh?\"}],[\"$\",\"span\",\"block-22-1\",{\"children\":\" An accurate review describes something that actually happened — a late shipment, a defect, a size that ran small, a support call that went badly — even if the tone is blunt. It's distinct from a false or malicious review, which describes something that didn't happen at all.\"}]]}]\n2f:[\"$\",\"p\",\"block-23\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-23-0\",{\"children\":\"Should a merchant ever ask to have an accurate negative review removed?\"}],[\"$\",\"span\",\"block-23-1\",{\"children\":\" No. Asking a platform to remove a true review because it's unflattering is a request most review platforms will refuse, and pursuing it anyway damages trust further if the customer or platform makes the attempt visible.\"}]]}]\n30:[\"$\",\"p\",\"block-24\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-24-0\",{\"children\":\"What should the public response actually say?\"}],[\"$\",\"span\",\"block-24-1\",{\"children\":\" Acknowledge the specific issue without minimizing it, state what's being done about it, and avoid arguing with the reviewer's account of events — even the parts that sting. The response is being read by every future shopper, not just the original reviewer.\"}]]}]\n31:[\"$\",\"p\",\"block-25\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-25-0\",{\"children\":\"Does fixing the underlying problem matter more than the response itself?\"}],[\"$\",\"span\",\"block-25-1\",{\"children\":\" Yes. A well-written response to a problem that recurs next month is worse than a plain response to a problem that actually gets fixed, because the next round of reviews will show whether anything changed.\"}]]}]\n32:[\"$\",\"section\",null,{\"className\":\"mt-12 border-t border-border pt-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted\",\"children\":\"Sources\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://www.uschamber.com/co/grow/customers/how-to-handle-a-bad-business-review\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.uschamber.com/co/grow/customers/how-to-handle-a-bad-business-review\",\"rel\":\"noopener noreferrer nofollow\",\"target\":\"_blank\",\"className\":\"break-all text-navy-light hover:underline\",\"children\":\"https://www.uschamber.com/co/grow/customers/how-to-handle-a-bad-business-review\"}]}]]}]]}]\n33:[\"$\",\"p\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/blog\",\"className\":\"text-sm text-text-muted hover:text-navy hover:underline\",\"children\":\"← All articles\"}]}]\n36:T637,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What makes a negative review \\\"factually accurate\\\" versus just harsh?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"An accurate review describes something that actually happened — a late shipment, a defect, a size that ran small, a support call that went badly — even if the tone is blunt. It's distinct from a false or malicious review, which describes something that didn't happen at all.\"}},{\"@type\":\"Question\",\"name\":\"Should a merchant ever ask to have an accurate negative review removed?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. Asking a platform to remove a true review because it's unflattering is a request most review platforms will refuse, and pursuing it anyway damages trust further if the customer or platform makes the attempt visible.\"}},{\"@type\":\"Question\",\"name\":\"What should the public response actually say?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Acknowledge the specific issue without minimizing it, state what's being done about it, and avoid arguing with the reviewer's account of events — even the parts that sting. The response is being read by every future shopper, not just the original reviewer.\"}},{\"@type\":\"Question\",\"name\":\"Does fixing the underlying problem matter more than the response itself?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. A well-written response to a problem that recurs next month is worse than a plain response to a problem that actually gets fixed, because the next round of reviews will show whether anything changed.\"}}]}34:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$36\"}}]\n35:[\"$\",\"footer\",null,{\"className\":\"border-t border-border bg-navy text-white\",\"data-scroll-theme\":\"dark\",\"children\":[[\"$\",\"section\",null,{\"className\":\"py-20 text-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl italic text-gold\",\"children\":\"Stop guessing if customers trust you.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-white/70\",\"children\":\"Show them proof. 1,200+ stores collect verified reviews with EarnedStar.\"}],[\"$\",\"$La\",null,{\"href\":\"/signup\",\"className\":\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-gold text-ink hover:bg-gold-light border-transparent shadow-[var(--shadow-gold)] h-12 px-6 text-base mt-8\",\"children\":\"Start Your Free Trial →\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl border-t border-white/10 px-4 py-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"$L37\",null,{\"size\":37,\"showBadge\":false}],[\"$\",\"$L9\",null,{\"size\":40,\"onDark\":true}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 max-w-xs text-sm text-white/60\",\"children\":\"Verified reviews for e-commerce stores that take trust seriously.\"}]]}],[[\"$\",\"nav\",\"Product\",{\"aria-label\":\"Product\",\"children\":[[\"$\",\"p\",null,{\"className\":\"smallcaps text-[11px] font-semibold text-white/60\",\"children\":\"Product\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-2 text-sm\",\"children\":[[\"$\",\"li\",\"/pricing\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/pricing\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Pricing\"}]}],[\"$\",\"li\",\"/features\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/features\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Features\"}]}],[\"$\",\"li\",\"/audit\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/audit\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"The Audit\"}]}],[\"$\",\"li\",\"/reviews/expedia-parts\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/reviews/expedia-parts\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Live Store\"}]}]]}]]}],[\"$\",\"nav\",\"Resources\",{\"aria-label\":\"Resources\",\"children\":[[\"$\",\"p\",null,{\"className\":\"smallcaps text-[11px] font-semibold text-white/60\",\"children\":\"Resources\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-2 text-sm\",\"children\":[[\"$\",\"li\",\"/blog\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/blog\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Blog\"}]}],[\"$\",\"li\",\"/yotpo-refugees\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/yotpo-refugees\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Yotpo Refugees\"}]}],[\"$\",\"li\",\"/help\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/help\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Help Guides\"}]}],[\"$\",\"li\",\"/support\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/support