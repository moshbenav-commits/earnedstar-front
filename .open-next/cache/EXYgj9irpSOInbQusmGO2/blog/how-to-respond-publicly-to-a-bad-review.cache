\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/04ck2bxtd1egb.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n11:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0qv2wjfea2o4h.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n12:[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/456tflun7xfy4.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1c:I[24510,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"MarketingNav\"]\n13:[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-cream text-ink antialiased\",\"data-scroll-theme\":\"light\",\"children\":[[\"$\",\"$L1c\",null,{}],[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-3xl px-4 py-16 sm:px-6\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Review response strategy\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":[5,\" min read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold text-navy sm:text-4xl\",\"children\":\"How to respond publicly to a bad review — and when not to\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-lg leading-relaxed text-text-muted\",\"children\":\"A public reply to a bad review is read by every future shopper, not just the reviewer. Here's what it should contain, and the specific cases where staying quiet is the better call.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 space-y-5 text-base leading-relaxed text-ink\",\"children\":[[\"$\",\"h1\",\"block-0\",{\"className\":\"text-2xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-0-0\",{\"children\":\"How to respond publicly to a bad review — and when not to\"}]]}],[\"$\",\"p\",\"block-1\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-1-0\",{\"children\":\"Quick answer.\"}],[\"$\",\"span\",\"block-1-1\",{\"children\":\" A public response to a bad review is read by every future shopper, not just the person who wrote it. It should acknowledge the specific issue and state a concrete next step, without defensiveness. But not every bad review needs a public reply — some are better handled privately, and answering a bait review can do more damage than the review itself.\"}]]}],[\"$\",\"h2\",\"block-2\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-2-0\",{\"children\":\"Who is the response actually written for?\"}]]}],[\"$\",\"p\",\"block-3\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-3-0\",{\"children\":\"Future shoppers, not the original reviewer.\"}]]}],[\"$\",\"p\",\"block-4\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-4-0\",{\"children\":\"By the time a merchant sees a bad review, the reviewer's immediate experience has already happened — a reply won't undo it. What the reply actually influences is everyone who reads the thread afterward, deciding whether this is a company that handles problems or ignores them. That audience shift changes what a good response looks like: it's less a conversation with one person and more a public demonstration of how complaints get handled here.\"}]]}],[\"$\",\"h2\",\"block-5\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-5-0\",{\"children\":\"What does a strong public response actually contain?\"}]]}],[\"$\",\"p\",\"block-6\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-6-0\",{\"children\":\"Two things, consistently: a specific acknowledgment, and a concrete next step.\"}]]}],[\"$\",\"p\",\"block-7\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-7-0\",{\"children\":\"- \"}],[\"$\",\"strong\",\"block-7-1\",{\"children\":\"Name the actual issue.\"}],[\"$\",\"span\",\"block-7-2\",{\"children\":\" \\\"We're sorry to hear about your experience\\\" is   filler. \\\"We're sorry the replacement part arrived without the mounting   bracket\\\" shows the merchant read the review, not just triggered a   template. - \"}],[\"$\",\"strong\",\"block-7-3\",{\"children\":\"State what happens next\"}],[\"$\",\"span\",\"block-7-4\",{\"children\":\", in terms specific enough to mean something —   a refund being processed, a corrected shipment going out, a direct line to   reach if the fix hasn't landed. A response with no next step is an   apology with nothing behind it.\"}]]}],[\"$\",\"p\",\"block-8\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-8-0\",{\"children\":\"Everything past those two elements is optional. A short, specific reply outperforms a long, generic one almost every time.\"}]]}],\"$L1d\",\"$L1e\",\"$L1f\",\"$L20\",\"$L21\",\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\"]}],\"$L2e\",\"$L2f\",\"$L30\"]}],\"$L31\"]}]\n33:I[97801,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"EarnedStarOutlineStar\"]\n1d:[\"$\",\"h2\",\"block-9\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-9-0\",{\"children\":\"What tone consistently makes a response worse?\"}]]}]\n1e:[\"$\",\"p\",\"block-10\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-10-0\",{\"children\":\"Defensiveness, even mild defensiveness.\"}]]}]\n1f:[\"$\",\"p\",\"block-11\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-11-0\",{\"children\":\"Explaining at length why the delay happened, gently implying the customer misused the product, or correcting small factual details in the review's account — all of it reads, to a future shopper, as an argument rather than an acknowledgment. Even where the merchant's version of events is more accurate, litigating it in public rarely helps; it makes the company look like it's more invested in being right than in fixing the problem.\"}]]}]\n20:[\"$\",\"div\",\"block-12\",{\"className\":\"overflow-x-auto rounded-lg border border-border\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full border-collapse text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-surface\",\"children\":[[\"$\",\"th\",\"block-12-h-0\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-h-0-0\",{\"children\":\"Response instinct\"}]]}],[\"$\",\"th\",\"block-12-h-1\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-h-1-0\",{\"children\":\"How it reads to future shoppers\"}]]}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"block-12-r-0\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-0-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-0-0-0\",{\"children\":\"\\\"We're sorry, here's what we're doing about it\\\"\"}]]}],[\"$\",\"td\",\"block-12-r-0-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-0-1-0\",{\"children\":\"Accountable\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-1\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-1-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-1-0-0\",{\"children\":\"\\\"Actually, our records show...\\\"\"}]]}],[\"$\",\"td\",\"block-12-r-1-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-1-1-0\",{\"children\":\"Defensive, distracts from the fix\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-2\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-2-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-2-0-0\",{\"children\":\"A generic, templated one-liner\"}]]}],[\"$\",\"td\",\"block-12-r-2-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-2-1-0\",{\"children\":\"Disengaged\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-3\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-3-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-3-0-0\",{\"children\":\"No response at all, indefinitely\"}]]}],[\"$\",\"td\",\"block-12-r-3-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-3-1-0\",{\"children\":\"Absent or indifferent\"}]]}]]}]]}]]}]}]\n21:[\"$\",\"h2\",\"block-13\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-13-0\",{\"children\":\"When should a merchant NOT respond publicly?\"}]]}]\n22:[\"$\",\"p\",\"block-14\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-14-0\",{\"children\":\"Two specific situations are worth naming directly.\"}]]}]\n23:[\"$\",\"p\",\"block-15\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-15-0\",{\"children\":\"When it's already resolved privately.\"}],[\"$\",\"span\",\"block-15-1\",{\"children\":\" If a customer's issue has been handled through support — refunded, replaced, closed out — restating that resolution publicly can look performative, especially if the original review predates the fix by only a few hours. A brief, factual note that the issue has been resolved is enough; a long public recap isn't necessary.\"}]]}]\n24:[\"$\",\"p\",\"block-16\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-16-0\",{\"children\":\"When the review is clearly bait, not a real complaint.\"}],[\"$\",\"span\",\"block-16-1\",{\"children\":\" A review with no specific, checkable claim, written to provoke an argument rather than describe an experience, rarely improves with engagement. Responding gives it more visibility and can invite exactly the back-and-forth it was written to produce. This is different from an accurate negative review, which always deserves a response — the distinction is whether there's an actual, specific claim behind it to address.\"}]]}]\n25:[\"$\",\"h2\",\"block-17\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-17-0\",{\"children\":\"Is there a right amount of time to wait before responding?\"}]]}]\n26:[\"$\",\"p\",\"block-18\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-18-0\",{\"children\":\"Not a fixed number, but both extremes carry a cost. A reply that sits unanswered for weeks reads as inattention — a company that either doesn't see its reviews or doesn't act on them. A reply posted within minutes, every time, in near-identical language, starts to read as templated regardless of how genuine the underlying process is. Prompt and specific beats fast for its own sake.\"}]]}]\n27:[\"$\",\"h2\",\"block-19\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-19-0\",{\"children\":\"How should this fit into a broader review response process?\"}]]}]\n28:[\"$\",\"p\",\"block-20\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-20-0\",{\"children\":\"As a standing habit, not a one-off decision made review by review. Deciding in the moment whether to respond, and how, invites inconsistency — one customer gets a thoughtful reply, another gets ignored for a month. A simple standing rule — every specific complaint gets a specific, prompt, non -defensive reply; genuinely resolved or clearly bad-faith threads are the only exceptions — keeps the response quality even across every review that comes in, not just the ones that happen to catch someone's attention.\"}]]}]\n29:[\"$\",\"h2\",\"block-21\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-21-0\",{\"children\":\"Frequently asked questions\"}]]}]\n2a:[\"$\",\"p\",\"block-22\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-22-0\",{\"children\":\"What should a public response to a bad review always include?\"}],[\"$\",\"span\",\"block-22-1\",{\"children\":\" A direct acknowledgment of the specific issue, and a concrete next step — a fix, a refund, a way to reach support directly. A response missing either one reads as either dismissive or empty.\"}]]}]\n2b:[\"$\",\"p\",\"block-23\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-23-0\",{\"children\":\"What tone should the response avoid?\"}],[\"$\",\"span\",\"block-23-1\",{\"children\":\" Defensiveness and over-explaining. Justifying the outcome at length, or subtly implying the customer is at fault, reads worse to every future shopper watching than the original negative review did.\"}]]}]\n2c:[\"$\",\"p\",\"block-24\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-24-0\",{\"children\":\"When should a merchant NOT respond publicly at all?\"}],[\"$\",\"span\",\"block-24-1\",{\"children\":\" When the review is already resolved through a direct channel and a public reply would just restate a private conversation, or when the reviewer is clearly using the thread to bait an argument rather than describe a real experience.\"}]]}]\n2d:[\"$\",\"p\",\"block-25\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-25-0\",{\"children\":\"Is there a time limit that matters for the response?\"}],[\"$\",\"span\",\"block-25-1\",{\"children\":\" Not a fixed one, but a long, visible gap between a bad review and any reply tends to read as inattention, while a rushed same-minute response can read as templated. Prompt and specific matters more than fast for its own sake.\"}]]}]\n2e:[\"$\",\"section\",null,{\"className\":\"mt-12 border-t border-border pt-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted\",\"children\":\"Sources\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://www.bazaarvoice.com/blog/how-to-respond-to-negative-reviews-examples-and-best-practices/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.bazaarvoice.com/blog/how-to-respond-to-negative-reviews-examples-and-best-practices/\",\"rel\":\"noopener noreferrer nofollow\",\"target\":\"_blank\",\"className\":\"break-all text-navy-light hover:underline\",\"children\":\"https://www.bazaarvoice.com/blog/how-to-respond-to-negative-reviews-examples-and-best-practices/\"}]}]]}]]}]\n2f:[\"$\",\"p\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"$La\",null,{\"href\":\"/blog\",\"className\":\"text-sm text-text-muted hover:text-navy hover:underline\",\"children\":\"← All articles\"}]}]\n32:T58b,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What should a public response to a bad review always include?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A direct acknowledgment of the specific issue, and a concrete next step — a fix, a refund, a way to reach support directly. A response missing either one reads as either dismissive or empty.\"}},{\"@type\":\"Question\",\"name\":\"What tone should the response avoid?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Defensiveness and over-explaining. Justifying the outcome at length, or subtly implying the customer is at fault, reads worse to every future shopper watching than the original negative review did.\"}},{\"@type\":\"Question\",\"name\":\"When should a merchant NOT respond publicly at all?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"When the review is already resolved through a direct channel and a public reply would just restate a private conversation, or when the reviewer is clearly using the thread to bait an argument rather than describe a real experience.\"}},{\"@type\":\"Question\",\"name\":\"Is there a time limit that matters for the response?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not a fixed one, but a long, visible gap between a bad review and any reply tends to read as inattention, while a rushed same-minute response can read as templated. Prompt and specific matters more than fast for its own sake.\"}}]}30:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$32\"}}]\n31:[\"$\",\"footer\",null,{\"className\":\"border-t border-border bg-navy text-white\",\"data-scroll-theme\":\"dark\",\"children\":[[\"$\",\"section\",null,{\"className\":\"py-20 text-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl italic text-gold\",\"children\":\"Stop guessing if customers trust you.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-white/70\",\"children\":\"Show them proof. 1,200+ stores collect verified reviews with EarnedStar.\"}],[\"$\",\"$La\",null,{\"href\":\"/signup\",\"className\":\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-gold text-ink hover:bg-gold-light border-transparent shadow-[var(--shadow-gold)] h-12 px-6 text-base mt-8\",\"children\":\"Start Your Free Trial →\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl border-t border-white/10 px-4 py-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"$L33\",null,{\"size\":37,\"showBadge\":false}],[\"$\",\"$L9\",null,{\"size\":40,\"onDark\":true}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 max-w-xs text-sm text-white/60\",\"children\":\"Verified reviews for e-commerce stores that take trust seriously.\"}]]}],[[\"$\",\"nav\",\"Product\",{\"aria-label\":\"Product\",\"children\":[[\"$\",\"p\",null,{\"className\":\"smallcaps text-[11px] font-semibold text-white/60\",\"children\":\"Product\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-2 text-sm\",\"children\":[[\"$\",\"li\",\"/pricing\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/pricing\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Pricing\"}]}],[\"$\",\"li\",\"/features\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/features\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Features\"}]}],[\"$\",\"li\",\"/audit\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/audit\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"The Audit\"}]}],[\"$\",\"li\",\"/reviews/expedia-parts\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/reviews/expedia-parts\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Live Store\"}]}]]}]]}],[\"$\",\"nav\",\"Resources\",{\"aria-label\":\"Resources\",\"children\":[[\"$\",\"p\",null,{\"className\":\"smallcaps text-[11px] font-semibold text-white/60\",\"children\":\"Resources\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-2 text-sm\",\"children\":[[\"$\",\"li\",\"/blog\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/blog\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Blog\"}]}],[\"$\",\"li\",\"/yotpo-refugees\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/yotpo-refugees\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Yotpo Refugees\"}]}],[\"$\",\"li\",\"/help\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/help\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Help Guides\"}]}],[\"$\",\"li\",\"/support\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/support\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Support\"}]}],[\"$\",\"li\",\"/contact\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/contact\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Contact\"}]}]]}]]}],[\"$\",\"nav\",\"Company\",{\"aria-label\":\"Company\",\"children\":[[\"$\",\"p\",null,{\"className\":\"smallcaps text-[11px] font-semibold text-white/60\",\"children\":\"Company\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-2 text-sm\",\"children\":[[\"$\",\"li\",\"/partnered-with-creytix\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/partnered-with-creytix\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Partnered with Creytix\"}]}],[\"$\",\"li\",\"/design-lab/brand\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/design-lab/brand\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Brand\"}]}],[\"$\",\"li\",\"/signup\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/signup\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Start free\"}]}]]}]]}],\"$L34\"]]}],\"$L35\",\"$L36\"]}]]}]\n37:I[2437,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"CreytixPartnerLockup\"]\n34:[\"$\",\"nav\",\"Legal\",{\"aria-label\":\"Legal\",\"children\":[[\"$\",\"p\",null,{\"className\":\"smallcaps text-[11px] font-semibold text-white/60\",\"children\":\"Legal\"}],[\"$\",\"ul\",null,{\"className\":\"mt-4 flex flex-col gap-2 text-sm\",\"children\":[[\"$\",\"li\",\"/privacy\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/privacy\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Privacy\"}]}],[\"$\",\"li\",\"/terms\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/terms\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Terms\"}]}],[\"$\",\"li\",\"/accessibility\",{\"children\":[\"$\",\"$La\",null,{\"href\":\"/accessibility\",\"className\":\"text-white/55 underline-offset-2 hover:text-white hover:underline\",\"children\":\"Accessibility\"}]}]]}]]}]\n35:[\"$\",\"div\",null,{\"className\":\"mt-10 border-t border-white/10 pt-8\",\"children\":[\"$\",\"$L37\",null,{\"partnerName\":\"EarnedStar\",\"partnerInitial\":\"E\",\"size\":\"sm\",\"surface\":\"dark\"}]}]\n36:[\"$\",\"p\",null,{\"className\":\"mt-4 text-xs text-white/60\",\"children\":\"© 2026 EarnedStar, Inc. · Los Angeles, CA\"}]\n19:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n38:I[18067,[\"/_next/static/chunks/0cxz40551t56w.js\",\"/_next/static/chunks/0mjm82_pbopny.js\"],\"IconMark\"]\n16:null\n1b:[[\"$\",\"title\",\"0\",{\"children\":\"How to respond publicly to a bad review — and when not to — EarnedStar | EarnedStar\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"A public reply to a bad review is read by every future shopper, not just the reviewer. Here's what it should contain, and the specific cases where staying quiet is the better call.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/site.webmanifest\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"link\",\"3\",{\"rel\":\"canonical\",\"href\":\"https://earnedstar.com/blog/how-to-respond-publicly-to-a-bad-review\"}],[\"$\",\"meta\",\"4\",{\"property\":\"og:title\",\"content\":\"How to respond publicly to a bad review — and when not to\"}],[\"$\",\"meta\",\"5\",{\"property\":\"og:description\",\"content\":\"A public reply to a bad review is read by every future shopper, not just the reviewer. Here's what it should contain, and the specific cases where staying quiet is the better call.\"}],[\"$\",\"meta\",\"6\",{\"property\":\"og:url\",\"content\":\"https://earnedstar.com/blog/how-to-respond-publicly-to-a-bad-review\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:site_name\",\"content\":\"EarnedStar\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"9\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:title\",\"content\":\"How to respond publicly to a bad review — and when not to\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:description\",\"content\":\"A public reply to a bad review is read by every future shopper, not just the reviewer. Here's what it should contain, and the specific cases where staying quiet is the better call.\"}],[\"$\",\"link\",\"12\",{\"rel\":\"icon\",\"href\":\"/icon\",\"sizes\":\"32x32\",\"type\":\"image/png\"}],[\"$\",\"link\",\"13\",{\"rel\":\"apple-touch-icon\",\"href\":\"/apple-icon\",\"sizes\":\"180x180\",\"type\":\"image/png\"}],[\"$\",\"$L38\",\"14\",{}]]\n","/blog/$d$slug/__PAGE__":"1:\"$Sreact.fragment\"\n2:I[24510,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"MarketingNav\"]\n1c:I[86696,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"\"]\n1e:I[97801,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"EarnedStarOutlineStar\"]\n1f:I[97801,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"EarnedStarWordmark\"]\n23:I[25281,[\"/_next/static/chunks/0cxz40551t56w.js\",\"/_next/static/chunks/0mjm82_pbopny.js\"],\"OutletBoundary\"]\n24:\"$Sreact.suspense\"\n26:I[2437,[\"/_next/static/chunks/1x4ew5tmsuku-.js\",\"/_next/static/chunks/2n1xat-2mwd-9.js\",\"/_next/static/chunks/3k-ek_0q7ozzd.js\",\"/_next/static/chunks/1i54d9w-76kdn.js\"],\"CreytixPartnerLockup\"]\n0:{\"rsc\":[\"$\",\"$1\",\"c\",{\"children\":[[\"$\",\"div\",null,{\"className\":\"min-h-screen bg-cream text-ink antialiased\",\"data-scroll-theme\":\"light\",\"children\":[[\"$\",\"$L2\",null,{}],[\"$\",\"article\",null,{\"className\":\"mx-auto max-w-3xl px-4 py-16 sm:px-6\",\"children\":[null,[\"$\",\"div\",null,{\"className\":\"mb-3 flex items-center gap-3 text-xs font-semibold uppercase tracking-wide text-text-muted\",\"children\":[[\"$\",\"span\",null,{\"children\":\"Review response strategy\"}],[\"$\",\"span\",null,{\"aria-hidden\":true,\"children\":\"·\"}],[\"$\",\"span\",null,{\"children\":[5,\" min read\"]}]]}],[\"$\",\"h1\",null,{\"className\":\"text-3xl font-bold text-navy sm:text-4xl\",\"children\":\"How to respond publicly to a bad review — and when not to\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-lg leading-relaxed text-text-muted\",\"children\":\"A public reply to a bad review is read by every future shopper, not just the reviewer. Here's what it should contain, and the specific cases where staying quiet is the better call.\"}],[\"$\",\"div\",null,{\"className\":\"mt-8 space-y-5 text-base leading-relaxed text-ink\",\"children\":[[\"$\",\"h1\",\"block-0\",{\"className\":\"text-2xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-0-0\",{\"children\":\"How to respond publicly to a bad review — and when not to\"}]]}],[\"$\",\"p\",\"block-1\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-1-0\",{\"children\":\"Quick answer.\"}],[\"$\",\"span\",\"block-1-1\",{\"children\":\" A public response to a bad review is read by every future shopper, not just the person who wrote it. It should acknowledge the specific issue and state a concrete next step, without defensiveness. But not every bad review needs a public reply — some are better handled privately, and answering a bait review can do more damage than the review itself.\"}]]}],[\"$\",\"h2\",\"block-2\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-2-0\",{\"children\":\"Who is the response actually written for?\"}]]}],[\"$\",\"p\",\"block-3\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-3-0\",{\"children\":\"Future shoppers, not the original reviewer.\"}]]}],[\"$\",\"p\",\"block-4\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-4-0\",{\"children\":\"By the time a merchant sees a bad review, the reviewer's immediate experience has already happened — a reply won't undo it. What the reply actually influences is everyone who reads the thread afterward, deciding whether this is a company that handles problems or ignores them. That audience shift changes what a good response looks like: it's less a conversation with one person and more a public demonstration of how complaints get handled here.\"}]]}],[\"$\",\"h2\",\"block-5\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-5-0\",{\"children\":\"What does a strong public response actually contain?\"}]]}],[\"$\",\"p\",\"block-6\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-6-0\",{\"children\":\"Two things, consistently: a specific acknowledgment, and a concrete next step.\"}]]}],[\"$\",\"p\",\"block-7\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-7-0\",{\"children\":\"- \"}],[\"$\",\"strong\",\"block-7-1\",{\"children\":\"Name the actual issue.\"}],[\"$\",\"span\",\"block-7-2\",{\"children\":\" \\\"We're sorry to hear about your experience\\\" is   filler. \\\"We're sorry the replacement part arrived without the mounting   bracket\\\" shows the merchant read the review, not just triggered a   template. - \"}],[\"$\",\"strong\",\"block-7-3\",{\"children\":\"State what happens next\"}],[\"$\",\"span\",\"block-7-4\",{\"children\":\", in terms specific enough to mean something —   a refund being processed, a corrected shipment going out, a direct line to   reach if the fix hasn't landed. A response with no next step is an   apology with nothing behind it.\"}]]}],[\"$\",\"p\",\"block-8\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-8-0\",{\"children\":\"Everything past those two elements is optional. A short, specific reply outperforms a long, generic one almost every time.\"}]]}],\"$L3\",\"$L4\",\"$L5\",\"$L6\",\"$L7\",\"$L8\",\"$L9\",\"$La\",\"$Lb\",\"$Lc\",\"$Ld\",\"$Le\",\"$Lf\",\"$L10\",\"$L11\",\"$L12\",\"$L13\"]}],\"$L14\",\"$L15\",\"$L16\"]}],\"$L17\"]}],[\"$L18\",\"$L19\",\"$L1a\"],\"$L1b\"]}],\"isPartial\":false,\"staleTime\":300,\"varyParams\":null,\"buildId\":\"EXYgj9irpSOInbQusmGO2\"}\n3:[\"$\",\"h2\",\"block-9\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-9-0\",{\"children\":\"What tone consistently makes a response worse?\"}]]}]\n4:[\"$\",\"p\",\"block-10\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-10-0\",{\"children\":\"Defensiveness, even mild defensiveness.\"}]]}]\n5:[\"$\",\"p\",\"block-11\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-11-0\",{\"children\":\"Explaining at length why the delay happened, gently implying the customer misused the product, or correcting small factual details in the review's account — all of it reads, to a future shopper, as an argument rather than an acknowledgment. Even where the merchant's version of events is more accurate, litigating it in public rarely helps; it makes the company look like it's more invested in being right than in fixing the problem.\"}]]}]\n6:[\"$\",\"div\",\"block-12\",{\"className\":\"overflow-x-auto rounded-lg border border-border\",\"children\":[\"$\",\"table\",null,{\"className\":\"w-full border-collapse text-sm\",\"children\":[[\"$\",\"thead\",null,{\"children\":[\"$\",\"tr\",null,{\"className\":\"bg-surface\",\"children\":[[\"$\",\"th\",\"block-12-h-0\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-h-0-0\",{\"children\":\"Response instinct\"}]]}],[\"$\",\"th\",\"block-12-h-1\",{\"className\":\"border-b border-border px-3 py-2 text-left font-semibold text-navy\",\"children\":[[\"$\",\"span\",\"block-12-h-1-0\",{\"children\":\"How it reads to future shoppers\"}]]}]]}]}],[\"$\",\"tbody\",null,{\"children\":[[\"$\",\"tr\",\"block-12-r-0\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-0-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-0-0-0\",{\"children\":\"\\\"We're sorry, here's what we're doing about it\\\"\"}]]}],[\"$\",\"td\",\"block-12-r-0-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-0-1-0\",{\"children\":\"Accountable\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-1\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-1-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-1-0-0\",{\"children\":\"\\\"Actually, our records show...\\\"\"}]]}],[\"$\",\"td\",\"block-12-r-1-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-1-1-0\",{\"children\":\"Defensive, distracts from the fix\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-2\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-2-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-2-0-0\",{\"children\":\"A generic, templated one-liner\"}]]}],[\"$\",\"td\",\"block-12-r-2-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-2-1-0\",{\"children\":\"Disengaged\"}]]}]]}],[\"$\",\"tr\",\"block-12-r-3\",{\"className\":\"border-b border-border last:border-b-0\",\"children\":[[\"$\",\"td\",\"block-12-r-3-0\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-3-0-0\",{\"children\":\"No response at all, indefinitely\"}]]}],[\"$\",\"td\",\"block-12-r-3-1\",{\"className\":\"px-3 py-2 align-top text-text-muted\",\"children\":[[\"$\",\"span\",\"block-12-r-3-1-0\",{\"children\":\"Absent or indifferent\"}]]}]]}]]}]]}]}]\n7:[\"$\",\"h2\",\"block-13\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-13-0\",{\"children\":\"When should a merchant NOT respond publicly?\"}]]}]\n8:[\"$\",\"p\",\"block-14\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-14-0\",{\"children\":\"Two specific situations are worth naming directly.\"}]]}]\n9:[\"$\",\"p\",\"block-15\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-15-0\",{\"children\":\"When it's already resolved privately.\"}],[\"$\",\"span\",\"block-15-1\",{\"children\":\" If a customer's issue has been handled through support — refunded, replaced, closed out — restating that resolution publicly can look performative, especially if the original review predates the fix by only a few hours. A brief, factual note that the issue has been resolved is enough; a long public recap isn't necessary.\"}]]}]\na:[\"$\",\"p\",\"block-16\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-16-0\",{\"children\":\"When the review is clearly bait, not a real complaint.\"}],[\"$\",\"span\",\"block-16-1\",{\"children\":\" A review with no specific, checkable claim, written to provoke an argument rather than describe an experience, rarely improves with engagement. Responding gives it more visibility and can invite exactly the back-and-forth it was written to produce. This is different from an accurate negative review, which always deserves a response — the distinction is whether there's an actual, specific claim behind it to address.\"}]]}]\nb:[\"$\",\"h2\",\"block-17\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-17-0\",{\"children\":\"Is there a right amount of time to wait before responding?\"}]]}]\nc:[\"$\",\"p\",\"block-18\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-18-0\",{\"children\":\"Not a fixed number, but both extremes carry a cost. A reply that sits unanswered for weeks reads as inattention — a company that either doesn't see its reviews or doesn't act on them. A reply posted within minutes, every time, in near-identical language, starts to read as templated regardless of how genuine the underlying process is. Prompt and specific beats fast for its own sake.\"}]]}]\nd:[\"$\",\"h2\",\"block-19\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-19-0\",{\"children\":\"How should this fit into a broader review response process?\"}]]}]\ne:[\"$\",\"p\",\"block-20\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"span\",\"block-20-0\",{\"children\":\"As a standing habit, not a one-off decision made review by review. Deciding in the moment whether to respond, and how, invites inconsistency — one customer gets a thoughtful reply, another gets ignored for a month. A simple standing rule — every specific complaint gets a specific, prompt, non -defensive reply; genuinely resolved or clearly bad-faith threads are the only exceptions — keeps the response quality even across every review that comes in, not just the ones that happen to catch someone's attention.\"}]]}]\nf:[\"$\",\"h2\",\"block-21\",{\"className\":\"pt-2 text-xl font-bold text-navy\",\"children\":[[\"$\",\"span\",\"block-21-0\",{\"children\":\"Frequently asked questions\"}]]}]\n10:[\"$\",\"p\",\"block-22\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-22-0\",{\"children\":\"What should a public response to a bad review always include?\"}],[\"$\",\"span\",\"block-22-1\",{\"children\":\" A direct acknowledgment of the specific issue, and a concrete next step — a fix, a refund, a way to reach support directly. A response missing either one reads as either dismissive or empty.\"}]]}]\n11:[\"$\",\"p\",\"block-23\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-23-0\",{\"children\":\"What tone should the response avoid?\"}],[\"$\",\"span\",\"block-23-1\",{\"children\":\" Defensiveness and over-explaining. Justifying the outcome at length, or subtly implying the customer is at fault, reads worse to every future shopper watching than the original negative review did.\"}]]}]\n12:[\"$\",\"p\",\"block-24\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-24-0\",{\"children\":\"When should a merchant NOT respond publicly at all?\"}],[\"$\",\"span\",\"block-24-1\",{\"children\":\" When the review is already resolved through a direct channel and a public reply would just restate a private conversation, or when the reviewer is clearly using the thread to bait an argument rather than describe a real experience.\"}]]}]\n13:[\"$\",\"p\",\"block-25\",{\"className\":\"text-ink\",\"children\":[[\"$\",\"strong\",\"block-25-0\",{\"children\":\"Is there a time limit that matters for the response?\"}],[\"$\",\"span\",\"block-25-1\",{\"children\":\" Not a fixed one, but a long, visible gap between a bad review and any reply tends to read as inattention, while a rushed same-minute response can read as templated. Prompt and specific matters more than fast for its own sake.\"}]]}]\n14:[\"$\",\"section\",null,{\"className\":\"mt-12 border-t border-border pt-6\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"mb-3 text-sm font-semibold uppercase tracking-wide text-text-muted\",\"children\":\"Sources\"}],[\"$\",\"ul\",null,{\"className\":\"space-y-2 text-sm\",\"children\":[[\"$\",\"li\",\"https://www.bazaarvoice.com/blog/how-to-respond-to-negative-reviews-examples-and-best-practices/\",{\"children\":[\"$\",\"a\",null,{\"href\":\"https://www.bazaarvoice.com/blog/how-to-respond-to-negative-reviews-examples-and-best-practices/\",\"rel\":\"noopener noreferrer nofollow\",\"target\":\"_blank\",\"className\":\"break-all text-navy-light hover:underline\",\"children\":\"https://www.bazaarvoice.com/blog/how-to-respond-to-negative-reviews-examples-and-best-practices/\"}]}]]}]]}]\n15:[\"$\",\"p\",null,{\"className\":\"mt-12\",\"children\":[\"$\",\"$L1c\",null,{\"href\":\"/blog\",\"className\":\"text-sm text-text-muted hover:text-navy hover:underline\",\"children\":\"← All articles\"}]}]\n1d:T58b,{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"What should a public response to a bad review always include?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"A direct acknowledgment of the specific issue, and a concrete next step — a fix, a refund, a way to reach support directly. A response missing either one reads as either dismissive or empty.\"}},{\"@type\":\"Question\",\"name\":\"What tone should the response avoid?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Defensiveness and over-explaining. Justifying the outcome at length, or subtly implying the customer is at fault, reads worse to every future shopper watching than the original negative review did.\"}},{\"@type\":\"Question\",\"name\":\"When should a merchant NOT respond publicly at all?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"When the review is already resolved through a direct channel and a public reply would just restate a private conversation, or when the reviewer is clearly using the thread to bait an argument rather than describe a real experience.\"}},{\"@type\":\"Question\",\"name\":\"Is there a time limit that matters for the response?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Not a fixed one, but a long, visible gap between a bad review and any reply tends to read as inattention, while a rushed same-minute response can read as templated. Prompt and specific matters more than fast for its own sake.\"}}]}16:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$1d\"}}]\n17:[\"$\",\"footer\",null,{\"className\":\"border-t border-border bg-navy text-white\",\"data-scroll-theme\":\"dark\",\"children\":[[\"$\",\"section\",null,{\"className\":\"py-20 text-center\",\"children\":[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-3xl px-4\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-display text-3xl italic text-gold\",\"children\":\"Stop guessing if customers trust you.\"}],[\"$\",\"p\",null,{\"className\":\"mt-4 text-white/70\",\"children\":\"Show them proof. 1,200+ stores collect verified reviews with EarnedStar.\"}],[\"$\",\"$L1c\",null,{\"href\":\"/signup\",\"className\":\"inline-flex items-center justify-center rounded-lg border font-semibold transition duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-navy bg-gold text-ink hover:bg-gold-light border-transparent shadow-[var(--shadow-gold)] h-12 px-6 text-base mt-8\",\"children\":\"Start Your Free Trial →\"}]]}]}],[\"$\",\"div\",null,{\"className\":\"mx-auto max-w-7xl border-t border-white/10 px-4 py-12\",\"children\":[[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 gap-10 md:grid-cols-[2fr_1fr_1fr_1fr_1fr]\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"span\",null,{\"className\":\"inline-flex items-center gap-2\",\"children\":[[\"$\",\"$L1e\",null,{\"size\":37,\"showBadge\":false}],[\"$\",\"$L1f\",null,{\"size\":40,\"onDark\":true}]]}],[\"$\",\"p\",null,{\"className\":\"mt-4 max-w-xs t