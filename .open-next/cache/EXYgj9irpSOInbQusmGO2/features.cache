1.62 L9.77,21.03 Q10.41,18.48 8.39,16.79 L7.92,16.40 Q2.63,11.99 9.50,11.54 L10.11,11.50 Q12.74,11.32 13.72,8.87 Z\" fill=\"none\" stroke=\"rgba(80,140,255,0.15)\" stroke-width=\"0.924\" clip-path=\"url(#cl-_R_2alfiv5b_)\"></path></svg></span><span class=\"font-sans font-bold leading-none tracking-tight\" style=\"font-size:13px\"><span class=\"text-navy\">Earned</span><span class=\"text-gold-dark\">Star</span></span></span></a><div class=\"hidden items-center gap-7 md:flex\"><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-ink/70 hover:text-ink\" href=\"/\">Manifesto</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-ink/70 hover:text-ink\" href=\"/pricing\">Pricing</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-ink/70 hover:text-ink\" href=\"/audit\">The Audit</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-ink/70 hover:text-ink\" href=\"/yotpo-refugees\">Yotpo Refugees</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-ink/70 hover:text-ink\" href=\"/reviews/expedia-parts\">Live Store</a><a class=\"text-[13px] font-semibold tracking-tight transition-colors text-ink/70 hover:text-ink\" href=\"/design-lab/brand\">Brand</a></div><div class=\"hidden items-center gap-3 md:flex\"><span class=\"smallcaps hidden text-[10px] lg:inline text-ink/70\">Vol. 01 · 2026</span><a class=\"rounded-full px-4 py-2 text-[13px] font-bold text-ink shadow-sm transition-shadow gold-foil hover:shadow-md\" href=\"/signup\">Start free</a></div><button type=\"button\" class=\"rounded-md p-2 md:hidden text-ink\" aria-label=\"Open menu\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></nav></header><main><section class=\"border-b border-ink/10 bg-cream px-6 py-16 sm:px-10 lg:px-14\" data-scroll-theme=\"light\"><div class=\"mx-auto max-w-[1400px]\"><p class=\"smallcaps text-gold-dark\">Product</p><h1 class=\"font-heading mt-3 max-w-3xl text-[clamp(2.25rem,5vw,3.75rem)] leading-tight tracking-tight text-navy\">Everything you need to collect, prove, and publish<!-- --> <span class=\"text-gold-dark italic underline-hand\">verified</span> reviews.</h1><p class=\"mt-5 max-w-2xl text-lg leading-relaxed text-ink/70\">Fraud-resistant review collection, native outreach, and compliance tooling — without per-order fees or annual lock-in.</p></div></section><section id=\"features\" class=\"section-warm py-16\" data-scroll-theme=\"light\"><div class=\"mx-auto max-w-7xl px-4\"><p class=\"text-center text-xs font-semibold uppercase tracking-widest text-navy-light\">Why EarnedStar</p><h2 class=\"mt-3 text-center text-3xl font-bold text-navy sm:text-4xl\">Everything generic review tools get wrong</h2><p class=\"mx-auto mt-4 max-w-2xl text-center text-text-muted\">Open platforms let anyone post anything. EarnedStar only publishes what was earned.</p><div class=\"mt-16 grid gap-4 md:grid-cols-2 lg:grid-cols-6\"><div class=\"card-surface gold-seam p-6 lg:col-span-3\" style=\"opacity:0;transform:translateY(16px)\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield mb-4 text-gold\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg><h3 class=\"text-lg font-bold text-navy\">AI Fraud Detection</h3><p class=\"mt-2 text-sm text-text-muted\">Every submission runs behavioral scoring, device fingerprinting, and NLP analysis in under 200ms. Fake reviews never reach your product page.</p></div><div class=\"card-surface gold-seam p-6 lg:col-span-3\" style=\"opacity:0;transform:translateY(16px)\"><div class=\"mb-4 flex flex-wrap gap-2\"><div class=\"inline-flex items-center gap-2 rounded-full border border-gold/30 bg-navy px-4 py-2 shadow-sm scale-90 origin-left\" data-surface=\"dark\"><span class=\"relative inline-block shrink-0\" style=\"width:28px;height:28px\"><svg width=\"28\" height=\"28\" viewBox=\"0 0 28 28\" overflow=\"visible\" aria-hidden=\"true\"><defs><filter id=\"ds-_R_5cj55fiv5b_\" x=\"-55%\" y=\"-45%\" width=\"210%\" height=\"210%\"><feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"0.8663200000000001\" result=\"b1\"></feGaussianBlur><feOffset in=\"b1\" dx=\"0.18563999999999997\" dy=\"2.3514399999999998\" result=\"off1\"></feOffset><feFlood flood-color=\"#00010f\" flood-opacity=\"0.7\" result=\"c1\"></feFlood><feComposite in=\"c1\" in2=\"off1\" operator=\"in\" result=\"sh1\"></feComposite><feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"2.4752\" result=\"b2\"></feGaussianBlur><feOffset in=\"b2\" dx=\"0\" dy=\"3.7127999999999997\" result=\"off2\"></feOffset><feFlood flood-color=\"#00010f\" flood-opacity=\"0.25\" result=\"c2\"></feFlood><feComposite in=\"c2\" in2=\"off2\" operator=\"in\" result=\"sh2\"></feComposite><feMerge><feMergeNode in=\"sh2\"></feMergeNode><feMergeNode in=\"sh1\"></feMergeNode><feMergeNode in=\"SourceGraphic\"></feMergeNode></feMerge></filter><radialGradient id=\"bg-_R_5cj55fiv5b_\" cx=\"30%\" cy=\"18%\" r=\"84%\" gradientUnits=\"objectBoundingBox\"><stop offset=\"0%\" stop-color=\"#3060b8\"></stop><stop offset=\"40%\" stop-color=\"#0b1d58\"></stop><stop offset=\"100%\" stop-color=\"#010509\"></stop></radialGradient><filter id=\"df-_R_5cj55fiv5b_\" x=\"-5%\" y=\"-5%\" width=\"110%\" height=\"110%\"><feGaussianBlur in=\"SourceAlpha\" stdDeviation=\"4.900896\" result=\"dome\"></feGaussianBlur><feDiffuseLighting in=\"dome\" lighting-color=\"#4878d0\" diffu